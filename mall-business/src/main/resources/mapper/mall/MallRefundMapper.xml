<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.aftersale.mapper.MallRefundMapper">
    <resultMap id="Refund" type="com.ruoyi.mall.aftersale.domain.MallRefund">
        <id property="refundId" column="refund_id"/><result property="refundNo" column="refund_no"/>
        <result property="orderId" column="order_id"/><result property="orderNo" column="order_no"/>
        <result property="memberId" column="member_id"/><result property="refundAmount" column="refund_amount"/>
        <result property="reason" column="reason"/><result property="status" column="status"/>
        <result property="originalOrderStatus" column="original_order_status"/>
        <result property="providerRefundNo" column="provider_refund_no"/>
        <result property="failureReason" column="failure_reason"/><result property="refundTime" column="refund_time"/>
        <result property="createTime" column="create_time"/><result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="columns">refund_id,refund_no,order_id,order_no,member_id,refund_amount,reason,status,original_order_status,provider_refund_no,failure_reason,refund_time,create_time,update_time</sql>
    <select id="selectByOrderIdForUpdate" resultMap="Refund">select <include refid="columns"/> from mall_refund where order_id=#{orderId} for update</select>
    <select id="selectByIdForUpdate" resultMap="Refund">select <include refid="columns"/> from mall_refund where refund_id=#{refundId} for update</select>
    <select id="selectByRefundNoForUpdate" resultMap="Refund">select <include refid="columns"/> from mall_refund where refund_no=#{refundNo} for update</select>
    <select id="selectMemberById" resultMap="Refund">select <include refid="columns"/> from mall_refund where refund_id=#{refundId} and member_id=#{memberId}</select>
    <select id="selectMemberList" resultMap="Refund">select <include refid="columns"/> from mall_refund where member_id=#{memberId} order by create_time desc,refund_id desc</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="refundId">
        insert ignore into mall_refund(refund_no,order_id,order_no,member_id,refund_amount,reason,status,original_order_status,create_time,update_time)
        values(#{refundNo},#{orderId},#{orderNo},#{memberId},#{refundAmount},#{reason},#{status},#{originalOrderStatus},now(),now())
    </insert>
    <update id="markRefunding">update mall_refund set status='REFUNDING',update_time=now() where refund_id=#{refundId} and status='APPLIED'</update>
    <update id="markSuccess">update mall_refund set status='SUCCESS',provider_refund_no=#{providerRefundNo},refund_time=now(),update_time=now() where refund_id=#{refundId} and status='REFUNDING'</update>
    <update id="markFailed">update mall_refund set status='FAILED',failure_reason=#{failureReason},update_time=now() where refund_id=#{refundId} and status='REFUNDING'</update>
    <update id="markRejected">update mall_refund set status='REJECTED',failure_reason=#{failureReason},update_time=now() where refund_id=#{refundId} and status in ('APPLIED','REFUNDING')</update>
</mapper>
