<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.reconciliation.mapper.MallReconciliationAlertMapper">
 <resultMap id="Alert" type="com.ruoyi.mall.reconciliation.domain.MallReconciliationAlert">
  <id property="alertId" column="alert_id"/><result property="alertNo" column="alert_no"/><result property="diffId" column="diff_id"/>
  <result property="alertLevel" column="alert_level"/><result property="status" column="status"/><result property="alertMessage" column="alert_message"/>
  <result property="acknowledgedBy" column="acknowledged_by"/><result property="acknowledgedTime" column="acknowledged_time"/>
  <result property="createTime" column="create_time"/><result property="updateTime" column="update_time"/>
 </resultMap>
 <sql id="columns">alert_id,alert_no,diff_id,alert_level,status,alert_message,acknowledged_by,acknowledged_time,create_time,update_time</sql>
 <insert id="insertIgnore" useGeneratedKeys="true" keyProperty="alertId">insert ignore into mall_reconciliation_alert(alert_no,diff_id,alert_level,status,alert_message,create_time,update_time) values(#{alertNo},#{diffId},#{alertLevel},'OPEN',#{alertMessage},now(),now())</insert>
 <select id="selectById" resultMap="Alert">select <include refid="columns"/> from mall_reconciliation_alert where alert_id=#{alertId}</select>
 <select id="selectList" resultMap="Alert">select <include refid="columns"/> from mall_reconciliation_alert <where><if test="status != null and status != ''">and status=#{status}</if></where> order by alert_id desc limit #{limit} offset #{offset}</select>
 <update id="acknowledge">update mall_reconciliation_alert set status='ACKED',acknowledged_by=#{operator},acknowledged_time=now(),update_time=now() where alert_id=#{alertId} and status='OPEN'</update>
</mapper>
