<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.risk.mapper.MallRiskMapper">
    <resultMap id="Risk" type="com.ruoyi.mall.risk.domain.MallRiskRecord">
        <id property="riskId" column="risk_id"/><result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/><result property="memberId" column="member_id"/>
        <result property="ruleCode" column="rule_code"/><result property="riskScore" column="risk_score"/>
        <result property="riskStatus" column="risk_status"/><result property="decision" column="decision"/>
        <result property="reason" column="reason"/><result property="orderAmount" column="order_amount"/>
        <result property="operatorType" column="operator_type"/><result property="operatorId" column="operator_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <select id="lockMemberForOrder" resultType="long">
        select member_id from mall_member where member_id=#{memberId} and status='0' for update
    </select>
    <select id="countPendingOrders" resultType="int">
        select count(1) from mall_order where member_id=#{memberId}
        and status='PENDING_PAYMENT' and payment_status in ('UNPAID','PAYING')
    </select>
    <insert id="insertRecord" useGeneratedKeys="true" keyProperty="riskId">
        insert into mall_risk_record(order_id,order_no,member_id,rule_code,risk_score,risk_status,decision,reason,order_amount,operator_type,operator_id,create_time)
        values(#{orderId},#{orderNo},#{memberId},#{ruleCode},#{riskScore},#{riskStatus},#{decision},#{reason},#{orderAmount},#{operatorType},#{operatorId},now())
    </insert>
    <select id="selectRecords" resultMap="Risk">
        select risk_id,order_id,order_no,member_id,rule_code,risk_score,risk_status,decision,reason,order_amount,operator_type,operator_id,create_time
        from mall_risk_record
        <where><if test="decision != null and decision != ''">decision=#{decision}</if></where>
        order by risk_id desc limit #{limit} offset #{offset}
    </select>
</mapper>
