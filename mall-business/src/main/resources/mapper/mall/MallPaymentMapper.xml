<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.payment.mapper.MallPaymentMapper">
    <resultMap id="Payment" type="com.ruoyi.mall.payment.domain.MallPayment">
        <id property="paymentId" column="payment_id"/>
        <result property="paymentNo" column="payment_no"/><result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/><result property="memberId" column="member_id"/>
        <result property="paymentMethod" column="payment_method"/><result property="amount" column="amount"/>
        <result property="status" column="status"/><result property="idempotencyKey" column="idempotency_key"/>
        <result property="providerPaymentNo" column="provider_payment_no"/><result property="paymentUrl" column="payment_url"/>
        <result property="failureReason" column="failure_reason"/><result property="paidTime" column="paid_time"/>
        <result property="createTime" column="create_time"/><result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectByOrderIdempotency" resultMap="Payment">
        select * from mall_payment where order_id=#{orderId} and member_id=#{memberId}
            and idempotency_key=#{idempotencyKey}
    </select>
    <select id="selectByPaymentNoForUpdate" resultMap="Payment">
        select * from mall_payment where payment_no=#{paymentNo} for update
    </select>
    <select id="selectByIdForUpdate" resultMap="Payment">
        select * from mall_payment where payment_id=#{paymentId} for update
    </select>
    <select id="selectSuccessByOrderIdForUpdate" resultMap="Payment">
        select * from mall_payment where order_id=#{orderId} and status='SUCCESS' order by payment_id desc limit 1 for update
    </select>
    <insert id="insertPayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert ignore into mall_payment(payment_no,order_id,order_no,member_id,payment_method,amount,status,idempotency_key,create_time,update_time)
        values(#{paymentNo},#{orderId},#{orderNo},#{memberId},#{paymentMethod},#{amount},#{status},#{idempotencyKey},now(),now())
    </insert>
    <update id="updateCreationResult">
        update mall_payment set status=#{status},provider_payment_no=#{providerPaymentNo},payment_url=#{paymentUrl},
            failure_reason=#{failureReason},update_time=now()
        where payment_id=#{paymentId} and status='CREATING'
    </update>
    <update id="updateSuccess">
        update mall_payment set status='SUCCESS',paid_time=now(),update_time=now()
        where payment_id=#{paymentId} and status='PAYING'
    </update>
</mapper>
