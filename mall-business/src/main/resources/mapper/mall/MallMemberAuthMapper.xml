<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.member.mapper.MallMemberAuthMapper">
    <resultMap id="SmsResult" type="com.ruoyi.mall.member.domain.MallSmsCode"><id property="smsId" column="sms_id"/><result property="phone" column="phone"/><result property="purpose" column="purpose"/><result property="codeHash" column="code_hash"/><result property="codeSalt" column="code_salt"/><result property="providerRequestId" column="provider_request_id"/><result property="sendStatus" column="send_status"/><result property="verifyAttempts" column="verify_attempts"/><result property="usedFlag" column="used_flag"/><result property="expireTime" column="expire_time"/><result property="usedTime" column="used_time"/><result property="requestIp" column="request_ip"/><result property="createTime" column="create_time"/></resultMap>
    <resultMap id="AddressResult" type="com.ruoyi.mall.member.domain.MallMemberAddress"><id property="addressId" column="address_id"/><result property="memberId" column="member_id"/><result property="receiverName" column="receiver_name"/><result property="receiverPhone" column="receiver_phone"/><result property="province" column="province"/><result property="city" column="city"/><result property="district" column="district"/><result property="detailAddress" column="detail_address"/><result property="postalCode" column="postal_code"/><result property="isDefault" column="is_default"/><result property="delFlag" column="del_flag"/></resultMap>
    <select id="selectLatestSmsCode" resultMap="SmsResult">select * from mall_sms_code where phone=#{phone} and purpose=#{purpose} order by sms_id desc limit 1</select>
    <select id="countSmsByPhoneSince" resultType="int">select count(*) from mall_sms_code where phone=#{phone} and create_time&gt;=#{since}</select>
    <select id="countSmsByIpSince" resultType="int">select count(*) from mall_sms_code where request_ip=#{requestIp} and create_time&gt;=#{since}</select>
    <insert id="insertSmsCode" useGeneratedKeys="true" keyProperty="smsId">insert into mall_sms_code(phone,purpose,code_hash,code_salt,send_status,verify_attempts,used_flag,expire_time,request_ip,create_time) values(#{phone},#{purpose},#{codeHash},#{codeSalt},#{sendStatus},#{verifyAttempts},#{usedFlag},#{expireTime},#{requestIp},now())</insert>
    <update id="updateSmsSendResult">update mall_sms_code set provider_request_id=#{providerRequestId},send_status=#{sendStatus} where sms_id=#{smsId}</update>
    <update id="incrementSmsAttempts">update mall_sms_code set verify_attempts=verify_attempts+1 where sms_id=#{smsId} and used_flag='0'</update>
    <update id="consumeSmsCode">update mall_sms_code set used_flag='1',used_time=now() where sms_id=#{smsId} and used_flag='0' and expire_time&gt;now()</update>
    <insert id="insertConsent" useGeneratedKeys="true" keyProperty="consentId">insert into mall_member_consent(member_id,consent_type,consent_version,consent_ip,consent_time) values(#{memberId},#{consentType},#{consentVersion},#{consentIp},#{consentTime})</insert>
    <select id="selectAddressList" resultMap="AddressResult">select * from mall_member_address where member_id=#{memberId} and del_flag='0' order by is_default desc,address_id desc</select>
    <select id="selectAddress" resultMap="AddressResult">select * from mall_member_address where address_id=#{addressId} and member_id=#{memberId} and del_flag='0'</select>
    <update id="clearDefaultAddress">update mall_member_address set is_default='0',update_time=now() where member_id=#{memberId} and del_flag='0'</update>
    <insert id="insertAddress" useGeneratedKeys="true" keyProperty="addressId">insert into mall_member_address(member_id,receiver_name,receiver_phone,province,city,district,detail_address,postal_code,is_default,del_flag,create_time) values(#{memberId},#{receiverName},#{receiverPhone},#{province},#{city},#{district},#{detailAddress},#{postalCode},#{isDefault},'0',now())</insert>
    <update id="updateAddress">update mall_member_address set receiver_name=#{receiverName},receiver_phone=#{receiverPhone},province=#{province},city=#{city},district=#{district},detail_address=#{detailAddress},postal_code=#{postalCode},is_default=#{isDefault},update_time=now() where address_id=#{addressId} and member_id=#{memberId} and del_flag='0'</update>
    <update id="deleteAddress">update mall_member_address set del_flag='2',update_time=now() where address_id=#{addressId} and member_id=#{memberId} and del_flag='0'</update>
</mapper>
