<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.reconciliation.mapper.MallReconciliationMapper">
 <resultMap id="Diff" type="com.ruoyi.mall.reconciliation.domain.MallReconciliationDiff">
  <id property="diffId" column="diff_id"/><result property="diffNo" column="diff_no"/><result property="diffType" column="diff_type"/>
  <result property="businessNo" column="business_no"/><result property="orderNo" column="order_no"/><result property="localStatus" column="local_status"/>
  <result property="externalStatus" column="external_status"/><result property="localAmount" column="local_amount"/><result property="externalAmount" column="external_amount"/>
  <result property="diffCode" column="diff_code"/><result property="diffMessage" column="diff_message"/><result property="status" column="status"/>
  <result property="handleRemark" column="handle_remark"/><result property="createTime" column="create_time"/><result property="updateTime" column="update_time"/><result property="resolvedTime" column="resolved_time"/>
 </resultMap>
 <sql id="columns">diff_id,diff_no,diff_type,business_no,order_no,local_status,external_status,local_amount,external_amount,diff_code,diff_message,status,handle_remark,create_time,update_time,resolved_time</sql>
 <insert id="insertIgnore" useGeneratedKeys="true" keyProperty="diffId">insert ignore into mall_reconciliation_diff(diff_no,diff_type,business_no,order_no,local_status,external_status,local_amount,external_amount,diff_code,diff_message,status,create_time,update_time) values(#{diffNo},#{diffType},#{businessNo},#{orderNo},#{localStatus},#{externalStatus},#{localAmount},#{externalAmount},#{diffCode},#{diffMessage},'OPEN',now(),now())</insert>
    <select id="selectById" resultMap="Diff">select <include refid="columns"/> from mall_reconciliation_diff where diff_id=#{diffId}</select>
    <select id="selectByBusinessCode" resultMap="Diff">select <include refid="columns"/> from mall_reconciliation_diff where diff_type=#{diffType} and business_no=#{businessNo} and diff_code=#{diffCode}</select>
 <select id="selectList" resultMap="Diff">select <include refid="columns"/> from mall_reconciliation_diff <where><if test="diffType != null and diffType != ''">and diff_type=#{diffType}</if><if test="status != null and status != ''">and status=#{status}</if><if test="businessNo != null and businessNo != ''">and business_no like concat('%',#{businessNo},'%')</if></where> order by diff_id desc limit #{limit} offset #{offset}</select>
 <update id="updateStatus">update mall_reconciliation_diff set status=#{status},handle_remark=#{remark},resolved_time=case when #{status} in ('RESOLVED','IGNORED') then now() else resolved_time end,update_time=now() where diff_id=#{diffId} and status in ('OPEN','PROCESSING','MANUAL')</update>
</mapper>
