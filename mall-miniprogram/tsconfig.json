{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/miniprogram-api-typings"]
  },
  "include": [
    "types.d.ts",
    "app.ts",
    "config/**/*.ts",
    "utils/**/*.ts",
    "services/**/*.ts",
    "components/**/*.ts",
    "custom-tab-bar/**/*.ts",
    "pages/**/*.ts"
  ]
}
