{
  "description": "商城 V0.6 原生微信小程序",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "libVersion": "3.7.3",
  "appid": "touristappid",
  "projectname": "mall-miniprogram",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": false,
    "compileHotReLoad": true,
    "coverView": true,
    "checkInvalidKey": false,
    "useCompilerPlugins": ["typescript"]
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": "scripts" }
    ]
  },
  "condition": {}
}
