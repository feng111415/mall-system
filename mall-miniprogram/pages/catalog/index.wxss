.page { min-height: 100vh; padding: 0 16px 88px; background: #fffefa; color: #20202a; }.heading { display: flex; min-height: 72px; align-items: center; justify-content: space-between; border-bottom: 2px solid #20202a; }.kicker { display: block; color: #ef5949; font-size: 10px; font-weight: 900; }.title { display: block; margin-top: 3px; font-size: 25px; font-weight: 900; }.heading > text { color: #74717a; font-size: 10px; }
.search { display: flex; height: 42px; align-items: center; gap: 8px; margin-top: 14px; border: 2px solid #20202a; border-radius: 8px; padding: 0 11px; background: #fff; box-shadow: 3px 3px 0 rgb(32 32 42 / 12%); }.search image { width: 18px; height: 18px; }.search input { flex: 1; min-width: 0; font-size: 12px; }.search text { color: #ef5949; font-size: 11px; font-weight: 900; }
.category-trigger { display: flex; width: 100% !important; min-width: 0 !important; height: 44px; align-items: center; justify-content: space-between; margin: 12px 0 14px !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 12px !important; background: #fff; color: #20202a; text-align: left; }.category-trigger::after { display: none; }.category-trigger > view { display: flex; min-width: 0; align-items: center; gap: 10px; }.category-trigger-label { color: #74717a; font-size: 10px; }.category-trigger-value { overflow: hidden; font-size: 12px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.category-trigger-action { flex: 0 0 auto; color: #ef5949; font-size: 10px; font-weight: 900; }.category-mask { position: fixed; z-index: 40; inset: 0; display: flex; align-items: flex-end; background: rgba(32,32,42,.42); }.category-sheet { width: 100%; max-height: 72vh; box-sizing: border-box; border-top: 2px solid #20202a; padding: 16px 16px calc(18px + env(safe-area-inset-bottom)); background: #fffefa; }.category-sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }.category-sheet-head text { display: block; }.category-sheet-head view text:first-child { font-size: 17px; font-weight: 900; }.category-sheet-head view text:last-child { margin-top: 4px; color: #74717a; font-size: 9px; }.category-sheet-head button { display: flex; width: 32px !important; min-width: 32px !important; height: 32px; align-items: center; justify-content: center; margin: 0 !important; border: 2px solid #20202a; border-radius: 50%; padding: 0 !important; background: #fff; font-size: 19px; line-height: 1; }.category-sheet-head button::after { display: none; }.category-list { max-height: 52vh; }.category-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; padding: 2px 0; }.category { display: flex; width: 100% !important; min-width: 0 !important; height: 40px; align-items: center; justify-content: center; overflow: hidden; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 9px; background: #fff; font-size: 10px; font-weight: 800; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }.category::after { display: none; }.category.active { background: #ffd84d; box-shadow: 2px 2px 0 #20202a; }
.product-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }.product { min-width: 0; overflow: hidden; border: 2px solid #20202a; border-radius: 8px; background: #fff; }.product > image { width: 100%; aspect-ratio: 1 / 1; background: #f1eee8; }.product-copy { padding: 10px; }.product-name,.subtitle { display: block; }.product-name { min-height: 34px; font-size: 12px; font-weight: 900; line-height: 1.35; }.subtitle { min-height: 28px; margin-top: 4px; overflow: hidden; color: #74717a; font-size: 9px; line-height: 1.45; }.product-copy > view { display: flex; align-items: end; justify-content: space-between; margin-top: 9px; }.price { font-size: 14px; font-weight: 900; }.sales { color: #8c878e; font-size: 8px; }
.empty { display: flex; min-height: 45vh; flex-direction: column; align-items: center; justify-content: center; gap: 13px; color: #74717a; font-size: 12px; }.empty button { height: 38px; border: 2px solid #20202a; border-radius: 7px; padding: 0 15px; background: #ffd84d; font-size: 10px; font-weight: 900; }
