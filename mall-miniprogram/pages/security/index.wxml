<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><button class="back" bindtap="goBack">←</button><text>登录设备</text><view></view></view>

  <state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" />
  <block wx:if="{{!loading && !error}}">
    <view class="security-head">
      <view class="security-title"><image class="security-icon" src="/assets/icons/shield-check.svg" /><view><text class="kicker">ACCOUNT SECURITY</text><text class="title">设备安全</text></view></view>
      <view class="limits"><view class="limit-item"><text class="limit-number">{{mobileCount}}</text><text>移动端在线</text></view><view class="limit-item limit-divider"><text class="limit-number">{{desktopCount}}</text><text>电脑端在线</text></view></view>
      <text class="quota">{{primaryChangeWindowDays}} 天内还可更换主设备 <text class="quota-number">{{primaryChangesRemaining}}</text> 次</text>
      <button wx:if="{{canReplacePrimary}}" class="primary-action" bindtap="openPrimary">设为主设备</button>
    </view>

    <text wx:if="{{feedback}}" class="feedback {{feedbackSuccess ? 'success' : ''}}">{{feedback}}</text>

    <view class="section-head"><view><text class="kicker">ONLINE</text><text class="section-title">在线设备</text></view><text class="count">{{sessions.length}} 台</text></view>
    <view wx:if="{{sessions.length}}" class="session-list">
      <view wx:for="{{sessions}}" wx:key="sessionId" class="session-card">
        <view class="session-main">
          <view class="device-icon"><image class="device-image" src="{{item.deviceIcon}}" /></view>
          <view class="session-copy">
            <view class="session-name"><text>{{item.deviceName}}</text><text wx:if="{{item.current}}" class="tag current">当前设备</text><text wx:if="{{item.primaryMobile}}" class="tag primary">主设备</text></view>
            <text class="session-meta">{{item.loginIp}} · {{item.loginTimeLabel}} 登录</text>
            <text class="session-expire">有效期至 {{item.expireTimeLabel}}</text>
          </view>
        </view>
        <button wx:if="{{!item.current}}" class="revoke-button" data-id="{{item.sessionId}}" bindtap="requestRevoke">下线</button>
        <text wx:else class="current-note">正在使用</text>
      </view>
    </view>
    <view wx:else class="empty">暂无在线设备</view>
  </block>

  <view wx:if="{{revokeTarget}}" class="mask" bindtap="closeRevoke"><view class="sheet" catchtap="noop"><view class="sheet-head"><view><text class="kicker">DEVICE</text><text class="sheet-title">下线设备</text></view><button class="close" bindtap="closeRevoke">×</button></view><text class="sheet-device">{{revokeTarget.deviceName}}</text><text class="sheet-meta">{{revokeTarget.loginIp}} · {{revokeTarget.loginTimeLabel}} 登录</text><view class="sheet-actions"><button class="sheet-action cancel" bindtap="closeRevoke" disabled="{{revokeBusy}}">取消</button><button class="sheet-action danger" bindtap="confirmRevoke" loading="{{revokeBusy}}" disabled="{{revokeBusy}}">确认下线</button></view></view></view>

  <view wx:if="{{primaryOpen}}" class="mask" bindtap="closePrimary"><view class="sheet" catchtap="noop"><view class="sheet-head"><view><text class="kicker">PRIMARY MOBILE</text><text class="sheet-title">设为主设备</text></view><button class="close" bindtap="closePrimary">×</button></view><view class="code-field"><input class="code-input" value="{{primaryCode}}" type="number" maxlength="6" placeholder="6 位短信验证码" bindinput="handlePrimaryCodeInput" /><button class="code-button {{primaryCodeSending || primarySeconds > 0 ? 'disabled' : ''}}" bindtap="sendPrimaryCode" loading="{{primaryCodeSending}}" disabled="{{primaryCodeSending || primarySeconds > 0}}">{{primarySeconds ? primarySeconds + 's 后重发' : '获取验证码'}}</button></view><text wx:if="{{primaryError}}" class="sheet-error">{{primaryError}}</text><button class="confirm-primary" bindtap="confirmPrimary" loading="{{primaryReplacing}}" disabled="{{primaryReplacing}}">确认设为主设备</button></view></view>
</view>
