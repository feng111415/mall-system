.page { min-height: 100vh; padding: 0 16px 36px; background: #fffefa; color: #20202a; }
.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 42px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }
.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; }
.security-head { margin-inline: -16px; border-bottom: 2px solid #20202a; padding: 18px 16px; background: #ffd84d; }
.security-title { display: flex; align-items: center; gap: 11px; }
.security-icon { width: 38px; height: 38px; border: 2px solid #20202a; border-radius: 7px; padding: 7px; background: #fff; }
.kicker,.title,.section-title,.session-meta,.session-expire,.quota,.sheet-device,.sheet-meta,.sheet-error { display: block; }
.kicker { color: #ed5b49; font-size: 9px; font-weight: 900; letter-spacing: 1px; }
.title { margin-top: 3px; font-size: 23px; font-weight: 900; }
.limits { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); margin-top: 16px; border-block: 2px solid #20202a; }
.limit-item { display: flex; min-height: 56px; align-items: baseline; justify-content: center; gap: 5px; padding: 10px; color: #5a5662; font-size: 10px; }
.limit-divider { border-left: 2px solid #20202a; }
.limit-number { color: #20202a; font-size: 24px; font-weight: 900; }
.quota { margin-top: 12px; color: #5a5662; font-size: 10px; }
.quota-number { color: #ed5b49; font-size: 17px; font-weight: 900; }
.primary-action { width: 100%; height: 42px; margin-top: 12px; border: 2px solid #20202a; border-radius: 6px; background: #20202a; color: #fff; font-size: 12px; font-weight: 900; }
.feedback { margin-top: 14px; border: 2px solid #20202a; border-radius: 6px; padding: 10px; background: #ffe2dc; color: #b73429; font-size: 10px; text-align: center; }
.feedback.success { background: #d6f2eb; color: #287a55; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 20px 0 12px; }
.section-title { margin-top: 3px; font-size: 19px; font-weight: 900; }
.count { color: #77737d; font-size: 10px; }
.session-list { display: grid; gap: 11px; }
.session-card { position: relative; min-height: 116px; border: 2px solid #20202a; border-radius: 8px; padding: 14px; background: #fff; box-shadow: 3px 3px 0 rgb(32 32 42 / 12%); }
.session-main { display: flex; align-items: flex-start; gap: 11px; }
.device-icon { display: flex; flex: 0 0 42px; width: 42px; height: 42px; align-items: center; justify-content: center; border: 2px solid #20202a; border-radius: 7px; background: #d6f2eb; }
.device-image { width: 22px; height: 22px; }
.session-copy { min-width: 0; padding-right: 58px; }
.session-name { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; font-size: 13px; font-weight: 900; }
.tag { border: 1px solid #20202a; border-radius: 99px; padding: 2px 5px; font-size: 8px; font-weight: 900; }
.tag.current { background: #ffd84d; }
.tag.primary { background: #d6f2eb; }
.session-meta,.session-expire { overflow-wrap: anywhere; color: #77737d; font-size: 9px; line-height: 1.55; }
.session-meta { margin-top: 7px; }
.session-expire { margin-top: 2px; }
.revoke-button { position: absolute; top: 14px; right: 12px; display: flex; width: 48px !important; min-width: 48px !important; max-width: 48px; height: 30px; align-items: center; justify-content: center; margin: 0; border: 2px solid #20202a; border-radius: 5px; padding: 0; background: #ffe2dc; color: #b73429; font-size: 9px; font-weight: 900; line-height: 26px; }
.current-note { position: absolute; top: 19px; right: 13px; color: #287a55; font-size: 9px; font-weight: 900; }
.empty { border-block: 2px solid #20202a; padding: 30px 0; color: #77737d; font-size: 11px; text-align: center; }
.mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; background: rgb(32 32 42 / 48%); }
.sheet { width: 100%; border: 2px solid #20202a; border-bottom: 0; border-radius: 12px 12px 0 0; padding: 20px 16px calc(20px + env(safe-area-inset-bottom)); background: #fffefa; box-shadow: 0 -5px 0 rgb(32 32 42 / 14%); }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; }
.sheet-title { display: block; margin-top: 4px; font-size: 21px; font-weight: 900; }
.close { display: flex; flex: 0 0 32px; width: 32px !important; min-width: 32px !important; max-width: 32px; height: 32px; align-items: center; justify-content: center; margin: 0; border: 2px solid #20202a; border-radius: 50%; padding: 0; background: #fff; font-size: 22px; line-height: 26px; }
.sheet-device { margin-top: 18px; font-size: 16px; font-weight: 900; }
.sheet-meta { margin-top: 5px; color: #77737d; font-size: 10px; }
.sheet-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; margin-top: 18px; }
.sheet-action,.confirm-primary { height: 43px; margin: 0; border: 2px solid #20202a; border-radius: 6px; font-size: 11px; font-weight: 900; }
.cancel { background: #fff; color: #20202a; }
.danger { background: #ed5b49; color: #fff; }
.code-field { display: grid; grid-template-columns: minmax(0,1fr) 104px; margin-top: 18px; border: 2px solid #20202a; border-radius: 7px; background: #fff; }
.code-input { height: 42px; padding: 0 11px; font-size: 14px; }
.code-button { height: 34px; align-self: center; margin: 0 5px 0 0; border: 2px solid #20202a; border-radius: 5px; padding: 0 6px; background: #ffd84d; color: #20202a; font-size: 9px; font-weight: 900; }
.code-button.disabled { opacity: .48; }
.sheet-error { margin-top: 9px; color: #b73429; font-size: 10px; }
.confirm-primary { width: 100%; margin-top: 14px; background: #20202a; color: #fff; }
