.page {
  min-height: 100vh;
  padding: 0 16px 92px;
  background: #fffefa;
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0 20px;
}
.kicker {
  display: block;
  color: #ed5b49;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}
.title {
  display: block;
  margin-top: 5px;
  font-size: 28px;
  font-weight: 900;
}
.header-icon {
  width: 32px;
  height: 32px;
}
.login-card,
.member-card {
  border: 2px solid #20202a;
  border-radius: 8px;
  background: #fff;
  box-shadow: 4px 4px 0 rgb(32 32 42 / 14%);
}
.login-card {
  padding: 20px;
}
.login-heading {
  margin-bottom: 20px;
}
.login-title {
  display: block;
  font-size: 22px;
  font-weight: 900;
}
.login-subtitle {
  display: block;
  margin-top: 5px;
  color: #77737d;
  font-size: 11px;
}
.field {
  margin-top: 12px;
  border: 2px solid #20202a;
  border-radius: 6px;
  padding: 9px 11px;
  background: #fffefa;
}
.field-label {
  display: block;
  margin-bottom: 5px;
  color: #77737d;
  font-size: 10px;
}
.field input {
  width: 100%;
  height: 27px;
  font-size: 15px;
}
.code-field {
  position: relative;
  padding-right: 112px;
}
.code-button {
  position: absolute;
  right: 8px;
  bottom: 8px;
  width: 98px;
  height: 30px;
  border: 2px solid #20202a;
  border-radius: 5px;
  background: #ffd84d;
  color: #20202a;
  font-size: 10px;
  font-weight: 900;
}
.code-button[disabled] {
  opacity: 0.48;
}
.agreement {
  display: block;
  margin: 15px 0;
  color: #77737d;
  font-size: 10px;
}
.agreement label {
  display: flex;
  align-items: center;
  gap: 4px;
}
.agreement checkbox {
  transform: scale(0.72);
}
.primary-button,
.verify-button {
  width: 100%;
  border: 2px solid #20202a;
  border-radius: 6px;
  background: #ed5b49;
  color: #fff;
  font-size: 14px;
  font-weight: 900;
}
.primary-button {
  height: 46px;
}
.feedback {
  display: block;
  margin-top: 12px;
  color: #ed5b49;
  font-size: 11px;
  line-height: 1.5;
}
.feedback-success {
  color: #287a55;
}
.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px;
  background: #ffd84d;
}
.member-main {
  display: flex;
  align-items: center;
  gap: 11px;
}
.avatar {
  display: flex;
  width: 52px;
  height: 52px;
  align-items: center;
  justify-content: center;
  border: 2px solid #20202a;
  border-radius: 50%;
  background: #fff;
}
.avatar-fallback {
  font-size: 22px;
  font-weight: 900;
}
.member-name,
.member-phone {
  display: block;
}
.member-name {
  font-size: 16px;
  font-weight: 900;
}
.member-phone {
  margin-top: 5px;
  color: #5a5662;
  font-size: 11px;
}
.member-tag {
  border: 2px solid #20202a;
  border-radius: 99px;
  padding: 5px 8px;
  background: #fff;
  font-size: 10px;
  font-weight: 900;
}
.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 18px 0;
  border-block: 2px solid #20202a;
  padding: 14px 0;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  border-right: 1px solid #d6d1ca;
  color: #77737d;
  font-size: 11px;
}
.quick-item:last-child {
  border-right: 0;
}
.quick-number {
  color: #20202a;
  font-size: 19px;
  font-weight: 900;
}
.settings {
  border: 2px solid #20202a;
  border-radius: 8px;
  background: #fff;
}
.setting-row {
  display: flex;
  min-height: 54px;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #d6d1ca;
  padding: 0 14px;
  font-size: 13px;
  font-weight: 800;
}
.setting-row:last-child {
  border-bottom: 0;
}
.setting-row image {
  width: 19px;
  height: 19px;
}
.arrow {
  margin-left: auto;
  color: #77737d;
  font-size: 16px;
}
.logout-button {
  margin-top: 18px;
  border: 2px solid #20202a;
  border-radius: 6px;
  background: #fff;
  color: #ed5b49;
  font-size: 13px;
  font-weight: 900;
}
.challenge-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgb(32 32 42 / 48%);
}
.challenge-sheet {
  width: 100%;
  border: 2px solid #20202a;
  border-bottom: 0;
  border-radius: 14px 14px 0 0;
  padding: 22px 16px calc(22px + env(safe-area-inset-bottom));
  background: #fffefa;
  box-shadow: 0 -5px 0 rgb(32 32 42 / 14%);
}
.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.sheet-title {
  display: block;
  margin-top: 5px;
  font-size: 21px;
  font-weight: 900;
}
.close-button {
  flex: 0 0 32px;
  width: 32px;
  min-width: 32px;
  height: 32px;
  margin: 0;
  padding: 0;
  border: 2px solid #20202a;
  border-radius: 50%;
  background: #fff;
  color: #20202a;
  font-size: 23px;
  line-height: 26px;
}
.sheet-note {
  display: block;
  margin: 12px 0 15px;
  color: #77737d;
  font-size: 11px;
  line-height: 1.6;
}
.scene {
  position: relative;
  height: 188px;
  overflow: hidden;
  border: 2px solid #20202a;
  border-radius: 7px;
  background: #f7a48c;
}
.scene-image {
  width: 100%;
  height: 100%;
}
.piece {
  position: absolute;
  bottom: 0;
  width: 50px;
  height: 50px;
  transform: translateX(-50%);
  border: 2px solid #20202a;
  box-shadow: 2px 2px 0 rgb(32 32 42 / 55%);
}
.track {
  height: 50px;
  margin: 12px 0;
  border: 2px solid #20202a;
  border-radius: 7px;
  padding: 2px 8px;
  background: #d6efeb;
}
.track slider {
  width: 100%;
  margin: 4px 0;
}
.challenge-error {
  display: block;
  margin: -3px 0 10px;
  color: #ed5b49;
  font-size: 11px;
}
.verify-button {
  height: 44px;
  background: #20202a;
}
