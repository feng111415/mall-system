.page { min-height: 100vh; padding: 0 16px 300px; background: #fffefa; color: #20202a; }.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 62px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }.topbar button { display: flex; min-width: 0 !important; height: 34px; align-items: center; justify-content: center; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 11px; font-weight: 900; }.topbar .icon-button { width: 34px !important; max-width: 34px !important; font-size: 20px; }.topbar .catalog-button { width: 60px !important; max-width: 60px !important; }.section { padding: 18px 0; border-bottom: 2px solid #20202a; }.section-head { display: flex; align-items: end; justify-content: space-between; font-size: 14px; font-weight: 900; }.section-head > text:last-child { color: #74717a; font-size: 10px; font-weight: 500; }.address-list { display: grid; gap: 8px; margin-top: 12px; }.address { display: block; min-height: 64px; border: 2px solid #c8c4c0; border-radius: 7px; padding: 10px 12px; background: #fff; text-align: left; }.address.active { border-color: #20202a; background: #fff1b7; box-shadow: 2px 2px 0 #20202a; }.address-main,.address-detail { display: block; }.address-main { font-size: 12px; font-weight: 900; }.address-detail { margin-top: 6px; color: #5f5b62; font-size: 10px; line-height: 1.45; }.default { margin-left: 5px; color: #ef5949; font-size: 9px; }.checkout-item { display: grid; grid-template-columns: 58px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 12px 0; border-bottom: 1px solid #d3cec7; }.checkout-item image { width: 58px; height: 58px; border: 2px solid #20202a; border-radius: 6px; background: #f1eee8; }.item-name,.item-sku,.item-meta { display: block; }.item-name { font-size: 12px; font-weight: 900; }.item-sku { margin-top: 4px; color: #74717a; font-size: 9px; }.item-meta { margin-top: 7px; color: #5f5b62; font-size: 10px; }.item-total { font-size: 12px; font-weight: 900; }.coupon-option { display: flex; width: 100%; min-height: 42px; align-items: center; justify-content: space-between; margin-top: 8px; border: 2px solid #c8c4c0; border-radius: 7px; padding: 0 10px; background: #fff; font-size: 10px; text-align: left; }.coupon-option.active { border-color: #20202a; background: #d6f2eb; }.coupon-option text:last-child { color: #74717a; font-size: 9px; }.remark-section textarea { width: 100%; min-height: 70px; margin-top: 10px; border: 2px solid #c8c4c0; border-radius: 7px; padding: 10px; background: #fff; color: #20202a; font-size: 11px; }.empty-note { margin-top: 10px; border: 1px dashed #aaa5a0; padding: 13px; color: #74717a; font-size: 10px; text-align: center; }.summary { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; border-top: 2px solid #20202a; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: #fffefa; }.summary-lines { display: grid; gap: 5px; font-size: 10px; }.summary-lines view { display: flex; justify-content: space-between; }.summary-lines .payable { margin-top: 4px; padding-top: 7px; border-top: 1px solid #d3cec7; font-size: 12px; font-weight: 900; }.summary-lines .payable text:last-child { font-size: 20px; }.validation { display: grid; gap: 3px; margin-top: 7px; color: #ef5949; font-size: 9px; }.order-result { display: grid; gap: 2px; margin-top: 7px; border: 2px solid #20202a; border-radius: 7px; padding: 8px 10px; background: #d6f2eb; font-size: 9px; }.order-result text:first-child { font-size: 11px; font-weight: 900; }.order-result text:last-child { color: #74717a; }.feedback { margin-top: 7px; border: 2px solid #20202a; border-radius: 7px; padding: 8px; background: #fff1b7; font-size: 10px; text-align: center; }.summary .primary { width: 100%; height: 42px; margin-top: 9px; border: 2px solid #20202a; border-radius: 7px; background: #ef5949; color: #fff; font-size: 12px; font-weight: 900; }.summary .primary[disabled] { background: #d5d1cc; color: #77737d; }
.text-action { border: 0; padding: 3px; background: transparent; color: #ef5949; font-size: 10px; font-weight: 900; }.sheet-mask { position: fixed; z-index: 40; inset: 0; display: flex; align-items: end; background: rgba(32,32,42,.42); }.address-sheet { width: 100%; border-top: 2px solid #20202a; padding: 16px 16px calc(18px + env(safe-area-inset-bottom)); background: #fffefa; }.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-size: 16px; font-weight: 900; }.sheet-head button { width: 32px; height: 32px; border: 2px solid #20202a; border-radius: 50%; background: #fff; font-size: 20px; line-height: 1; }.address-sheet input,.address-sheet textarea,.region-picker { width: 100%; min-height: 42px; margin-top: 8px; border: 2px solid #c8c4c0; border-radius: 7px; padding: 10px; background: #fff; font-size: 11px; }.region-picker { color: #74717a; }.address-sheet textarea { min-height: 58px; }.save-address { width: 100%; height: 42px; margin-top: 10px; border: 2px solid #20202a; border-radius: 7px; background: #ffd84d; color: #20202a; font-size: 12px; font-weight: 900; }
.address-error { display: block; margin-top: 7px; color: #ef5949; font-size: 10px; }
