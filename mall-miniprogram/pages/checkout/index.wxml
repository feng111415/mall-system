<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><button class="icon-button" aria-label="返回" bindtap="goBack">←</button><text>确认订单</text><button class="catalog-button" bindtap="goCart">购物车</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" />
  <block wx:if="{{!loading && !error && preview}}">
    <view class="section address-section"><view class="section-head"><text>收货地址</text><button class="text-action" bindtap="openAddressForm">新增地址</button></view><view wx:if="{{preview.addresses.length}}" class="address-list"><button wx:for="{{preview.addresses}}" wx:key="addressId" class="address {{selectedAddressId === item.addressId ? 'active' : ''}}" data-id="{{item.addressId}}" bindtap="chooseAddress"><text class="address-main">{{item.displayReceiver}} <text wx:if="{{item.defaultFlag}}" class="default">默认</text></text><text class="address-detail">{{item.displayAddress}}</text></button></view><view wx:else class="empty-note">结算需要有效收货地址，请先新增。</view></view>
    <view class="section"><view class="section-head"><text>商品清单</text><text>{{preview.itemCount}} 件</text></view><view wx:for="{{preview.items}}" wx:key="skuId" class="checkout-item"><image src="{{item.displayImage}}" mode="aspectFill" /><view><text class="item-name">{{item.productName}}</text><text class="item-sku">{{item.skuName || item.skuCode}}</text><text class="item-meta">¥{{item.displayUnitPrice}} × {{item.quantity}}</text></view><text class="item-total">¥{{item.displayLineAmount}}</text></view><view wx:if="{{!preview.items.length}}" class="empty-note">没有已勾选的有效商品。</view></view>
    <view class="section"><view class="section-head"><text>优惠券</text><text>{{preview.coupons.length}} 张可用</text></view><button class="coupon-option {{!selectedCouponId ? 'active' : ''}}" data-id="0" bindtap="chooseCoupon"><text>不使用优惠券</text><text>本单保留</text></button><button wx:for="{{preview.coupons}}" wx:key="memberCouponId" class="coupon-option {{selectedCouponId === item.memberCouponId ? 'active' : ''}}" data-id="{{item.memberCouponId}}" bindtap="chooseCoupon"><text>{{item.couponName}} · 减 ¥{{item.displayDiscount}}</text><text>满 ¥{{item.displayThreshold}} 可用</text></button><view wx:if="{{!preview.coupons.length}}" class="empty-note">暂无可用优惠券</view></view>
    <view class="section remark-section"><view class="section-head"><text>订单备注</text><text>{{remark.length}}/200</text></view><textarea value="{{remark}}" maxlength="200" auto-height placeholder="选填，填写配送说明" bindinput="handleRemark" disabled="{{order}}" /></view>
    <view class="summary"><view class="summary-lines"><view><text>商品金额</text><text>¥{{preview.productAmount}}</text></view><view><text>运费</text><text>{{preview.shippingFee === '0' ? '免运费' : '¥' + preview.shippingFee}}</text></view><view><text>优惠</text><text>-¥{{preview.discountAmount}}</text></view><view class="payable"><text>应付金额</text><text>¥{{preview.payableAmount}}</text></view></view><view wx:if="{{preview.validationMessages.length}}" class="validation"><text wx:for="{{preview.validationMessages}}" wx:key="*this">{{item}}</text></view><view wx:if="{{order}}" class="order-result"><text>订单已创建 · 待支付</text><text>订单号 {{order.orderNo}}</text><text>请在服务端给出的支付时限内完成支付</text></view><view wx:if="{{feedback}}" class="feedback">{{feedback}}</view><button wx:if="{{!order}}" class="primary" bindtap="submitOrder" disabled="{{!preview.canSubmit || !selectedAddressId || submitting}}">{{submitting ? '正在提交...' : preview.canSubmit ? '提交订单' : '暂不能提交'}}</button><button wx:else class="primary" bindtap="openOrderDetail">查看订单详情</button></view>
  </block>
  <view wx:if="{{addressFormOpen}}" class="sheet-mask" bindtap="closeAddressForm"><view class="address-sheet" catchtap="noop"><view class="sheet-head"><text>新增收货地址</text><button bindtap="closeAddressForm">×</button></view><input data-field="receiverName" value="{{addressForm.receiverName}}" maxlength="50" placeholder="收货人" bindinput="handleAddressInput" /><input data-field="receiverPhone" value="{{addressForm.receiverPhone}}" type="number" maxlength="11" placeholder="手机号码" bindinput="handleAddressInput" /><picker mode="region" value="{{addressForm.region}}" bindchange="handleRegionChange"><view class="region-picker">{{addressForm.regionText || '选择省市区'}}</view></picker><textarea data-field="detailAddress" value="{{addressForm.detailAddress}}" maxlength="255" auto-height placeholder="详细地址" bindinput="handleAddressInput" /><text wx:if="{{addressError}}" class="address-error">{{addressError}}</text><button class="save-address" bindtap="saveAddress" disabled="{{addressSaving}}">{{addressSaving ? '正在保存...' : '保存并使用'}}</button></view></view>
</view>
