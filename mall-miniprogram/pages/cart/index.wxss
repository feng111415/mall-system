.page { min-height: 100vh; padding: 0 16px 112px; background: #fffefa; color: #20202a; }.heading { display: flex; min-height: 72px; align-items: end; justify-content: space-between; border-bottom: 2px solid #20202a; padding-bottom: 12px; }.heading > text { color: #74717a; font-size: 10px; }.kicker { display: block; color: #ef5949; font-size: 10px; font-weight: 900; }.title { display: block; margin-top: 5px; font-size: 26px; font-weight: 900; }.empty { display: flex; min-height: 58vh; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 12px; text-align: center; }.empty-title { color: #20202a; font-size: 20px; font-weight: 900; }.empty button { margin-top: 8px; border: 2px solid #20202a; border-radius: 7px; padding: 10px 18px; background: #ffd84d; color: #20202a; font-size: 12px; font-weight: 900; }.cart-list { padding-top: 8px; }.cart-item { display: grid; grid-template-columns: 28px 72px minmax(0,1fr); gap: 10px; align-items: start; padding: 16px 0; border-bottom: 1px solid #d3cec7; }.cart-item.invalid,.cart-item.shortage { opacity: .65; }.check { width: 26px; height: 26px; border: 2px solid #20202a; border-radius: 50%; padding: 0; background: #fff; color: #20202a; font-size: 14px; font-weight: 900; line-height: 20px; }.check.checked { background: #ffd84d; }.item-image { width: 72px; height: 72px; border: 2px solid #20202a; border-radius: 6px; background: #f1eee8; }.item-copy { min-width: 0; }.status { display: block; color: #44a86d; font-size: 9px; font-weight: 800; }.invalid .status,.shortage .status { color: #ef5949; }.item-name { display: block; margin-top: 5px; overflow: hidden; font-size: 13px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.sku-name { display: block; margin-top: 4px; color: #74717a; font-size: 10px; }.unit-price { display: block; margin-top: 8px; font-size: 12px; font-weight: 900; }.item-actions { grid-column: 3; display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 4px; }.quantity { display: flex; height: 30px; align-items: center; border: 2px solid #20202a; border-radius: 6px; background: #fff; }.quantity button { width: 27px; height: 26px; border: 0; padding: 0; background: transparent; font-size: 16px; }.quantity text { width: 24px; font-size: 11px; text-align: center; }.line-price { margin-left: auto; font-size: 12px; font-weight: 900; }.remove { border: 0; padding: 4px; background: transparent; color: #ef5949; font-size: 10px; }.feedback { margin-top: 10px; border: 2px solid #20202a; border-radius: 7px; padding: 9px; background: #fff1b7; font-size: 11px; text-align: center; }.summary { position: fixed; z-index: 19; right: 0; bottom: 66px; left: 0; display: grid; grid-template-columns: 1fr 150px; gap: 8px; align-items: center; border-top: 2px solid #20202a; padding: 10px 16px; background: #fffefa; }.summary > view { display: flex; align-items: baseline; gap: 8px; font-size: 11px; }.summary-price { font-size: 19px; font-weight: 900; }.summary .primary { min-height: 42px; border: 2px solid #20202a; border-radius: 7px; padding: 0 8px; background: #ef5949; color: #fff; font-size: 10px; font-weight: 900; }.summary .primary[disabled] { background: #d5d1cc; color: #77737d; }
