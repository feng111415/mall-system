.page { min-height: 100vh; padding: 0 16px 96px; background: #fffefa; color: #20202a; }
.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 54px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }
.topbar .icon-button,.topbar .catalog-button { display: flex; min-width: 0 !important; max-width: 100% !important; height: 34px; align-items: center; justify-content: center; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 12px; font-weight: 900; line-height: 1; overflow: hidden; }
.topbar .icon-button { width: 34px !important; max-width: 34px !important; padding: 0 !important; font-size: 20px; }.topbar .catalog-button { width: 52px !important; max-width: 52px !important; padding: 0 !important; }
.topbar .icon-button::after,.topbar .catalog-button::after { display: none; content: none; border: 0; }
.gallery { padding: 16px 0 0; }.main-image { width: 100%; aspect-ratio: 1 / 1; border: 2px solid #20202a; border-radius: 8px; background: #f1eee8; }
.thumb-scroll { width: 100%; padding-top: 10px; white-space: nowrap; }.thumb-row { display: inline-flex; gap: 8px; }.thumb { width: 58px; height: 58px; overflow: hidden; border: 2px solid #cbc6bf; border-radius: 6px; padding: 0; background: #fff; }.thumb.active { border-color: #20202a; box-shadow: 2px 2px 0 #ffd84d; }.thumb image { width: 100%; height: 100%; }
.product-copy { padding: 18px 2px; border-bottom: 2px solid #20202a; }.kicker { display: block; color: #ef5949; font-size: 10px; font-weight: 900; }.product-title-row { display: flex; align-items: flex-start; gap: 10px; margin-top: 6px; }.product-name { display: block; min-width: 0; flex: 1; font-size: 26px; font-weight: 900; line-height: 1.18; }.favorite { display: flex; width: 70px !important; min-width: 70px !important; height: 36px; align-items: center; justify-content: center; gap: 4px; margin: 0 !important; border: 2px solid #20202a; border-radius: 6px; padding: 0 !important; background: #fff; font-size: 9px; font-weight: 900; }.favorite.active { background: #ffd84d; box-shadow: 2px 2px 0 #20202a; }.favorite image { width: 15px; height: 15px; }.subtitle { display: block; margin-top: 7px; color: #74717a; font-size: 12px; line-height: 1.55; }.price-row { display: flex; align-items: baseline; gap: 8px; margin-top: 14px; }.price { font-size: 25px; font-weight: 900; }.market-price { color: #9c989e; font-size: 12px; text-decoration: line-through; }.sales { margin-left: auto; color: #74717a; font-size: 10px; }
.sku-section { padding: 18px 0; border-bottom: 2px solid #20202a; }.section-head { display: flex; align-items: end; justify-content: space-between; font-size: 14px; font-weight: 900; }.section-head > text:last-child { color: #74717a; font-size: 10px; font-weight: 500; }.sku-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-top: 12px; }.sku { display: flex; min-height: 43px; align-items: center; justify-content: space-between; border: 2px solid #20202a; border-radius: 7px; padding: 0 11px; background: #fff; font-size: 11px; font-weight: 800; }.sku.active { background: #ffd84d; box-shadow: 2px 2px 0 #20202a; }.sku.soldout { border-color: #c8c4c0; color: #959197; background: #f2f0ed; }.sku text:last-child:not(:first-child) { font-size: 9px; }
.stock { display: flex; align-items: center; gap: 7px; margin-top: 12px; font-size: 11px; }.stock-dot { width: 8px; height: 8px; border-radius: 50%; background: #44a86d; }.stock.limited .stock-dot { background: #ed9e2d; }.stock.soldout .stock-dot { background: #ef5949; }
.service-strip { display: flex; justify-content: space-between; gap: 6px; padding: 13px 0; border-bottom: 1px solid #d3cec7; color: #5f5b62; font-size: 9px; font-weight: 700; }.service-strip text::before { content: '✓ '; color: #44a86d; }
.detail-section,.review-section { padding: 22px 0; border-bottom: 2px solid #20202a; }.section-title { display: block; margin-top: 4px; font-size: 20px; font-weight: 900; }.detail-text { display: block; margin-top: 14px; color: #555159; font-size: 12px; line-height: 1.8; white-space: pre-wrap; }
.review-head { align-items: start; }.review-head > text { padding-top: 4px; }.review-summary { display: grid; grid-template-columns: 64px 1fr auto; align-items: center; gap: 10px; margin-top: 15px; border: 2px solid #20202a; border-radius: 7px; padding: 13px; background: #fff1b7; }.rating { font-size: 31px; font-weight: 900; }.stars { display: block; color: #ef5949; font-size: 11px; letter-spacing: 0; }.summary-label { display: block; margin-top: 3px; color: #74717a; font-size: 9px; }.star-count { display: flex; flex-direction: column; gap: 4px; color: #5f5b62; font-size: 9px; }
.review-list { margin-top: 10px; }.review { padding: 13px 0; border-bottom: 1px solid #d3cec7; }.review-meta { display: flex; align-items: start; justify-content: space-between; color: #74717a; font-size: 9px; }.review-meta > view > text:first-child { display: block; color: #20202a; font-size: 11px; font-weight: 900; }.review-content { display: block; margin-top: 9px; font-size: 11px; line-height: 1.55; }.review-sku { display: block; margin-top: 6px; color: #74717a; font-size: 9px; }.empty-review { margin-top: 12px; border: 1px dashed #aaa5a0; padding: 16px; color: #74717a; font-size: 10px; text-align: center; }
.feedback { position: fixed; z-index: 21; right: 16px; bottom: 76px; left: 16px; border: 2px solid #20202a; border-radius: 7px; padding: 10px 12px; background: #fff1b7; color: #20202a; font-size: 11px; font-weight: 800; text-align: center; }.feedback.error { background: #ffe1dc; color: #9d342b; }.bottom-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 86px 1fr; gap: 8px; border-top: 2px solid #20202a; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: #fffefa; }.bottom-bar > button,.bottom-bar .primary { height: 44px; border: 2px solid #20202a; border-radius: 7px; background: #fff; font-size: 11px; font-weight: 900; }.buy-group { display: grid; grid-template-columns: 86px 1fr; gap: 6px; min-width: 0; }.quantity { display: flex; height: 44px; align-items: center; justify-content: space-between; border: 2px solid #20202a; border-radius: 7px; background: #fff; }.quantity button { width: 24px; height: 40px; border: 0; background: transparent; font-size: 18px; }.quantity text { font-size: 12px; font-weight: 900; }.bottom-bar .primary { background: #ef5949; color: #fff; }.bottom-bar .primary[disabled] { background: #d5d1cc; color: #77737d; }
