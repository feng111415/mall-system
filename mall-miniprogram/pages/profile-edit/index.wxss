.page { min-height: 100vh; padding: 0 16px 36px; background: #fffefa; color: #20202a; }
.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 42px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }
.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; }
.profile-hero { display: grid; grid-template-columns: 68px minmax(0, 1fr); gap: 12px; align-items: center; margin-top: 16px; border: 2px solid #20202a; border-radius: 8px; padding: 16px; background: #ffd84d; box-shadow: 4px 4px 0 rgb(32 32 42 / 14%); }
.current-avatar { display: flex; width: 64px; height: 64px; align-items: center; justify-content: center; border: 2px solid #20202a; border-radius: 50%; background: #fff; }
.avatar-fallback { font-size: 24px; font-weight: 900; }
.hero-copy { min-width: 0; }
.hero-name,.hero-phone { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hero-name { font-size: 17px; font-weight: 900; }
.hero-phone { margin-top: 5px; color: #5a5662; font-size: 10px; }
.album-button { display: flex; width: 100%; height: 39px; grid-column: 1 / -1; align-items: center; justify-content: center; gap: 7px; margin: 0; border: 2px solid #20202a; border-radius: 6px; padding: 0 12px; background: #fff; font-size: 11px; font-weight: 900; }
.album-button image { width: 16px; height: 16px; }
.section { margin-top: 18px; border-top: 2px solid #20202a; padding-top: 15px; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 12px; }
.section-kicker,.section-title { display: block; }
.section-kicker { color: #ed5b49; font-size: 9px; font-weight: 900; letter-spacing: 1px; }
.section-title { margin-top: 3px; font-size: 18px; font-weight: 900; }
.section-meta { color: #77737d; font-size: 10px; }
.preset-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
.preset { display: flex; min-width: 0; min-height: 94px; flex-direction: column; align-items: center; justify-content: center; gap: 6px; margin: 0; border: 2px solid #d6d1ca; border-radius: 7px; padding: 8px 4px; background: #fff; color: #5a5662; font-size: 9px; font-weight: 800; }
.preset::after { display: none; }
.preset image { width: 50px; height: 50px; border: 2px solid #20202a; border-radius: 50%; }
.preset.selected { border-color: #20202a; background: #d6f2eb; box-shadow: 3px 3px 0 #20202a; color: #20202a; }
.secondary-button,.primary-button { width: 100%; height: 42px; margin-top: 12px; border: 2px solid #20202a; border-radius: 6px; font-size: 11px; font-weight: 900; }
.secondary-button { background: #d6f2eb; color: #20202a; }
.primary-button { background: #ed5b49; color: #fff; }
.secondary-button[disabled],.primary-button[disabled],.album-button[disabled] { opacity: .48; }
.nickname-field { border: 2px solid #20202a; border-radius: 7px; padding: 9px 11px; background: #fff; }
.nickname-field input { width: 100%; height: 30px; font-size: 14px; }
.quota { display: flex; align-items: baseline; gap: 4px; margin-top: 9px; color: #77737d; font-size: 10px; }
.quota-number { color: #ed5b49; font-size: 16px; font-weight: 900; }
.feedback { display: block; margin-top: 16px; border: 2px solid #20202a; border-radius: 6px; padding: 10px; background: #ffe2dc; color: #b73429; font-size: 10px; text-align: center; }
.feedback.success { background: #d6f2eb; color: #287a55; }
