.page { min-height: 100vh; padding: 0 16px 100px; overflow-x: hidden; background: #fffefa; color: #20202a; }.heading { display: grid; min-height: 76px; grid-template-columns: 42px minmax(0,1fr) auto; align-items: end; gap: 10px; border-bottom: 2px solid #20202a; padding-bottom: 12px; }.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; line-height: 1; }.heading-copy { min-width: 0; }.order-count { align-self: center; color: #74717a; font-size: 10px; }.kicker { display: block; color: #ef5949; font-size: 10px; font-weight: 900; }.title { display: block; margin-top: 5px; font-size: 26px; font-weight: 900; }.filters { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; overflow-x: hidden; padding: 12px 0; }.filter { width: 100% !important; min-width: 0 !important; min-height: 32px; margin: 0 !important; border: 2px solid #c8c4c0; border-radius: 16px; padding: 0 6px !important; background: #fff; color: #74717a; font-size: 10px; }.filter.active { border-color: #20202a; background: #ffd84d; color: #20202a; font-weight: 900; }.order-list { display: grid; gap: 10px; }.order-card { border: 2px solid #20202a; border-radius: 8px; padding: 13px; background: #fff; }.order-head,.order-body { display: flex; align-items: center; justify-content: space-between; gap: 8px; }.order-head { font-size: 10px; font-weight: 800; }.status { color: #ef5949; }.order-body { margin-top: 15px; color: #74717a; font-size: 10px; }.order-body text:nth-child(2) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.amount { color: #20202a; font-size: 14px; font-weight: 900; }.empty { display: flex; min-height: 58vh; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 12px; text-align: center; }.empty-title { color: #20202a; font-size: 20px; font-weight: 900; }.empty button { margin-top: 8px; border: 2px solid #20202a; border-radius: 7px; padding: 10px 18px; background: #ffd84d; font-size: 12px; font-weight: 900; }
