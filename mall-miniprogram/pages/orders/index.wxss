.page { min-height: 100vh; padding: 0 16px 100px; background: #fffefa; color: #20202a; }.heading { display: flex; min-height: 72px; align-items: end; justify-content: space-between; border-bottom: 2px solid #20202a; padding-bottom: 12px; }.heading > text { color: #74717a; font-size: 10px; }.kicker { display: block; color: #ef5949; font-size: 10px; font-weight: 900; }.title { display: block; margin-top: 5px; font-size: 26px; font-weight: 900; }.filters { display: flex; gap: 6px; overflow-x: auto; padding: 12px 0; }.filters button { flex: 0 0 auto; min-height: 30px; border: 2px solid #c8c4c0; border-radius: 16px; padding: 0 10px; background: #fff; color: #74717a; font-size: 10px; }.filters button.active { border-color: #20202a; background: #ffd84d; color: #20202a; font-weight: 900; }.order-list { display: grid; gap: 10px; }.order-card { border: 2px solid #20202a; border-radius: 8px; padding: 13px; background: #fff; }.order-head,.order-body { display: flex; align-items: center; justify-content: space-between; gap: 8px; }.order-head { font-size: 10px; font-weight: 800; }.status { color: #ef5949; }.order-body { margin-top: 15px; color: #74717a; font-size: 10px; }.order-body text:nth-child(2) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.amount { color: #20202a; font-size: 14px; font-weight: 900; }.empty { display: flex; min-height: 58vh; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 12px; text-align: center; }.empty-title { color: #20202a; font-size: 20px; font-weight: 900; }.empty button { margin-top: 8px; border: 2px solid #20202a; border-radius: 7px; padding: 10px 18px; background: #ffd84d; font-size: 12px; font-weight: 900; }
