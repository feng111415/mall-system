<view class="page"><view style="height: {{statusBarHeight}}px;"></view><view class="heading"><button class="back" bindtap="goBack">←</button><view class="heading-copy"><text class="kicker">YOUR ORDERS</text><text class="title">订单中心</text></view><text class="order-count">{{orders.length}} 笔</text></view><view wx:if="{{loggedIn}}" class="filters"><button class="filter {{!status ? 'active' : ''}}" data-status="" bindtap="selectStatus">全部</button><button class="filter {{status === 'PENDING_PAYMENT' ? 'active' : ''}}" data-status="PENDING_PAYMENT" bindtap="selectStatus">待付款</button><button class="filter {{status === 'PENDING_SHIPMENT' ? 'active' : ''}}" data-status="PENDING_SHIPMENT" bindtap="selectStatus">待发货</button><button class="filter {{status === 'SHIPPED' ? 'active' : ''}}" data-status="SHIPPED" bindtap="selectStatus">待收货</button><button class="filter {{status === 'COMPLETED' ? 'active' : ''}}" data-status="COMPLETED" bindtap="selectStatus">已完成</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" /><view wx:if="{{!loading && !loggedIn}}" class="empty"><text class="empty-title">登录后查看订单</text><text>订单状态和支付记录会跟随会员账号保存。</text><button bindtap="goLogin">去登录</button></view><view wx:elif="{{!loading && !error && orders.length}}" class="order-list"><view wx:for="{{orders}}" wx:key="orderId" class="order-card" data-id="{{item.orderId}}" bindtap="openOrder"><view class="order-head"><text>{{item.orderNo}}</text><text class="status">{{item.statusLabel}}</text></view><view class="order-body"><text>{{item.displayTime}}</text><text>{{item.itemSummary}}</text><text class="amount">¥{{item.displayAmount}}</text></view></view></view><view wx:elif="{{!loading && !error}}" class="empty"><text class="empty-title">暂时没有订单</text><text>完成一次结算后，订单会显示在这里。</text><button bindtap="goCatalog">去逛商品</button></view></view>
