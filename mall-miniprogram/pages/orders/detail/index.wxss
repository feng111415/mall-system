.page { min-height: 100vh; padding: 0 16px 96px; background: #fffefa; color: #20202a; }.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 42px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; }.status-band { display: grid; gap: 4px; margin-top: 14px; border: 2px solid #20202a; border-radius: 8px; padding: 15px; background: #fff1b7; }.status-band text:first-child { font-size: 21px; font-weight: 900; }.status-band text:not(:first-child) { color: #5f5b62; font-size: 10px; }.section { padding: 18px 0; border-bottom: 2px solid #20202a; }.section-head { display: flex; justify-content: space-between; font-size: 14px; font-weight: 900; }.section-head text:last-child { color: #74717a; font-size: 10px; font-weight: 500; }.order-item { display: grid; grid-template-columns: 62px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 12px 0; border-bottom: 1px solid #d3cec7; }.order-item image { width: 62px; height: 62px; border: 2px solid #20202a; border-radius: 6px; }.item-name,.muted { display: block; }.item-name { font-size: 12px; font-weight: 900; }.muted { margin-top: 4px; color: #74717a; font-size: 9px; }.amount { font-size: 12px; font-weight: 900; }.receiver,.address,.remark { display: block; margin-top: 10px; font-size: 11px; }.receiver { font-weight: 900; }.address,.remark { color: #5f5b62; line-height: 1.55; }.money { display: grid; gap: 7px; font-size: 10px; }.money view { display: flex; justify-content: space-between; }.money .payable { border-top: 1px solid #d3cec7; padding-top: 9px; font-size: 13px; font-weight: 900; }.money .payable text:last-child { font-size: 20px; }.record { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; padding: 10px 0; border-bottom: 1px solid #d3cec7; font-size: 9px; }.record text:first-child { font-weight: 900; }.record text:nth-child(2) { overflow: hidden; color: #5f5b62; text-overflow: ellipsis; white-space: nowrap; }.empty-note { padding: 14px 0; color: #74717a; font-size: 10px; }.feedback { margin-top: 10px; border: 2px solid #20202a; border-radius: 7px; padding: 9px; background: #d6f2eb; font-size: 10px; text-align: center; }.actions { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; justify-content: flex-end; gap: 8px; border-top: 2px solid #20202a; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: #fffefa; }.actions button { min-height: 42px; border: 2px solid #20202a; border-radius: 7px; padding: 0 14px; font-size: 11px; font-weight: 900; }.primary { background: #ef5949; color: #fff; }.secondary { background: #fff; }.mask { position: fixed; z-index: 40; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; background: rgba(32,32,42,.42); }.cancel-sheet { width: 100%; border-top: 2px solid #20202a; padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); background: #fffefa; font-size: 16px; font-weight: 900; }.cancel-sheet textarea { width: 100%; min-height: 70px; margin-top: 10px; border: 2px solid #c8c4c0; border-radius: 7px; padding: 10px; background: #fff; font-size: 11px; }.cancel-sheet > view { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }.cancel-sheet button { height: 42px; border: 2px solid #20202a; border-radius: 7px; background: #fff; font-size: 11px; font-weight: 900; }.cancel-sheet .danger { background: #ef5949; color: #fff; }
.production-note { margin-top: 10px; border: 1px dashed #aaa5a0; padding: 10px; color: #74717a; font-size: 9px; text-align: center; }
.action-error { margin-top: 10px; border: 2px solid #20202a; border-radius: 7px; padding: 9px; background: #ffe2dd; color: #9f2d24; font-size: 10px; text-align: center; }
.item-aftersale { display: flex; gap: 6px; margin-top: 7px; }.item-aftersale button { min-width: 58px; height: 26px; border: 1px solid #20202a; border-radius: 5px; padding: 0 7px; background: #ffd84d; font-size: 8px; font-weight: 900; }.item-aftersale button.progress { background: #d6f2eb; }.after-sale-error { margin-top: 10px; border: 1px dashed #ed5b49; padding: 8px; color: #9f2d24; font-size: 9px; }
.logistics-section { border-bottom-width: 3px; }.logistics-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; border: 2px solid #20202a; border-radius: 7px; padding: 11px; background: #d6f2eb; }.logistics-summary view { min-width: 0; }.logistics-summary view text { display: block; }.logistics-summary view text:first-child { font-size: 12px; font-weight: 900; }.logistics-summary view text:last-child { margin-top: 4px; overflow-wrap: anywhere; color: #5f5b62; font-size: 9px; }.logistics-summary > text { flex: 0 0 auto; font-size: 11px; font-weight: 900; }.timeline { margin-top: 14px; }.timeline-node { display: grid; grid-template-columns: 18px minmax(0,1fr); gap: 7px; }.timeline-rail { position: relative; display: flex; justify-content: center; }.timeline-rail::after { position: absolute; top: 13px; bottom: 0; width: 2px; background: #c8c4c0; content: ''; }.timeline-node:last-child .timeline-rail::after { display: none; }.timeline-rail text { position: relative; z-index: 1; width: 9px; height: 9px; margin-top: 4px; border: 2px solid #20202a; border-radius: 50%; background: #fff; }.timeline-node.current .timeline-rail text { background: #ffd84d; }.timeline-content { min-width: 0; padding-bottom: 15px; }.timeline-content > view { display: flex; justify-content: space-between; gap: 8px; }.timeline-content > view text:first-child { font-size: 11px; font-weight: 900; }.timeline-content > view text:last-child { color: #74717a; font-size: 9px; }.timeline-title,.timeline-description,.timeline-location { display: block; margin-top: 4px; font-size: 10px; line-height: 1.45; overflow-wrap: anywhere; }.timeline-title { font-weight: 800; }.timeline-description,.timeline-location { color: #5f5b62; }.timeline-location { color: #ef5949; }.logistics-error { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; border: 1px dashed #c8c4c0; padding: 10px; color: #9f2d24; font-size: 10px; }.logistics-error button { min-width: 72px; border: 2px solid #20202a; border-radius: 6px; padding: 6px 8px; background: #fff; font-size: 9px; font-weight: 900; }.receipt-state { border: 2px solid #20202a; border-radius: 7px; padding: 9px; background: #ffd84d; font-size: 10px; font-weight: 900; text-align: center; }.receipt-sheet { width: 100%; border-top: 2px solid #20202a; padding: 18px 16px calc(18px + env(safe-area-inset-bottom)); background: #fffefa; }.receipt-sheet > text { display: block; }.receipt-sheet > text:first-child { font-size: 16px; font-weight: 900; }.receipt-sheet > text:nth-child(2) { margin-top: 7px; color: #5f5b62; font-size: 10px; }.receipt-sheet > view { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 15px; }.receipt-sheet button { height: 42px; border: 2px solid #20202a; border-radius: 7px; background: #fff; font-size: 11px; font-weight: 900; }.receipt-sheet .confirm { background: #ffd84d; }.receipt-error { margin-top: 10px !important; border: 1px solid #ef5949; padding: 8px; background: #ffe2dd; color: #9f2d24 !important; }
