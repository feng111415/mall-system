<view class="page"><view style="height: {{statusBarHeight}}px;"></view><view class="topbar"><button class="back" bindtap="goBack">←</button><text>订单详情</text><text></text></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" /><block wx:if="{{!loading && !error && order}}"><view class="status-band"><text>{{order.statusLabel}}</text><text>支付状态：{{order.paymentLabel}}</text><text wx:if="{{order.status === 'PENDING_PAYMENT'}}">剩余 {{countdown}}</text></view><view class="section"><view class="section-head"><text>商品快照</text><text>{{order.items.length}} 项</text></view><view wx:for="{{order.items}}" wx:key="orderItemId" class="order-item"><image src="{{item.displayImage}}" mode="aspectFill" /><view><text class="item-name">{{item.productName}}</text><text class="muted">{{item.skuName || item.skuCode}}</text><text class="muted">¥{{item.displayUnitPrice}} × {{item.quantity}}</text></view><text class="amount">¥{{item.displayLineAmount}}</text></view></view><view class="section"><view class="section-head"><text>收货信息</text></view><text class="receiver">{{order.receiverName}} · {{order.receiverPhone}}</text><text class="address">{{order.receiverProvince}} {{order.receiverCity}} {{order.receiverDistrict}} {{order.receiverDetailAddress}}</text><text wx:if="{{order.remark}}" class="remark">备注：{{order.remark}}</text></view><view class="section money"><view><text>商品金额</text><text>¥{{order.displayProductAmount}}</text></view><view><text>运费</text><text>¥{{order.displayShippingFee}}</text></view><view><text>优惠</text><text>-¥{{order.displayDiscountAmount}}</text></view><view class="payable"><text>应付金额</text><text>¥{{order.displayAmount}}</text></view></view><view class="section"><view class="section-head"><text>支付记录</text><text>{{payments.length}} 次</text></view><view wx:for="{{payments}}" wx:key="paymentId" class="record"><text>{{item.statusLabel}}</text><text>{{item.paymentNo}}</text><text>{{item.displayTime}}</text></view><view wx:if="{{!payments.length}}" class="empty-note">尚未创建支付单</view></view><view class="section"><view class="section-head"><text>操作记录</text><text>{{order.operations.length}} 条</text></view><view wx:for="{{order.operations}}" wx:key="operationId" class="record"><text>{{item.statusLabel}}</text><text>{{item.remark}}</text><text>{{item.displayTime}}</text></view></view><view wx:if="{{!developmentMode && order.status === 'PENDING_PAYMENT'}}" class="production-note">正式微信支付待配置商户号与 AppID 后开放</view><view wx:if="{{actionError}}" class="action-error">{{actionError}}</view><view wx:if="{{feedback}}" class="feedback">{{feedback}}</view><view class="actions"><button wx:if="{{order.canCancel}}" class="secondary" bindtap="openCancel" disabled="{{busy}}">取消订单</button><button wx:if="{{developmentMode && order.canCreatePayment}}" class="primary" bindtap="createPayment" disabled="{{busy}}">创建模拟支付</button><button wx:if="{{developmentMode && order.canConfirmPayment && payments.length && payments[0].status === 'PAYING'}}" class="primary" bindtap="confirmPayment" disabled="{{busy}}">模拟支付成功</button></view></block><view wx:if="{{cancelOpen}}" class="mask" bindtap="closeCancel"><view class="cancel-sheet" catchtap="noop"><text>取消订单</text><textarea value="{{cancelReason}}" maxlength="200" bindinput="handleCancelReason" /><view><button bindtap="closeCancel">返回</button><button class="danger" bindtap="cancelOrder" disabled="{{busy}}">确认取消</button></view></view></view></view>
