.page { min-height: 100vh; padding: 0 16px 36px; background: #fffefa; color: #20202a; }
.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 42px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }
.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; }
.tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 14px 0; }
.tabs button { min-width: 0; height: 40px; margin: 0; border: 2px solid #20202a; border-radius: 6px; background: #fff; font-size: 11px; font-weight: 900; }
.tabs button.active { background: #ffd84d; box-shadow: 2px 2px 0 #20202a; }
.coupon-list { display: grid; gap: 12px; }
.coupon { position: relative; display: grid; min-height: 116px; grid-template-columns: 94px minmax(0, 1fr); overflow: hidden; border: 2px solid #20202a; border-radius: 8px; background: #fff; box-shadow: 3px 3px 0 rgb(32 32 42 / 12%); }
.coupon-value { display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 2px dashed #20202a; background: #ffd84d; font-size: 9px; }
.amount { font-size: 23px; font-weight: 900; }
.coupon-main { display: flex; min-width: 0; flex-direction: column; justify-content: space-between; padding: 16px 12px; }
.coupon-name,.coupon-scope,.coupon-time { display: block; }
.coupon-name { padding-right: 48px; font-size: 14px; font-weight: 900; }
.coupon-scope,.coupon-time { margin-top: 5px; color: #77737d; font-size: 9px; }
.coupon-status { position: absolute; top: 10px; right: 9px; border: 1px solid #20202a; border-radius: 99px; padding: 3px 6px; background: #d6f2eb; font-size: 8px; font-weight: 900; }
.coupon.inactive { opacity: .62; filter: grayscale(.65); }
.coupon.claimable { grid-template-columns: 94px minmax(0, 1fr) 52px; }
.claim { align-self: center; width: 44px !important; min-width: 0 !important; height: 34px; margin: 0 8px 0 0 !important; border: 2px solid #20202a; border-radius: 5px; padding: 0 !important; background: #ed5b49; color: #fff; font-size: 10px; font-weight: 900; }
.feedback { display: block; margin-bottom: 12px; border: 2px solid #20202a; border-radius: 6px; padding: 9px; background: #d6f2eb; font-size: 10px; text-align: center; }
.empty { display: flex; min-height: 340px; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 11px; text-align: center; }
.empty-title { color: #20202a; font-size: 18px; font-weight: 900; }
.empty button { height: 40px; margin-top: 4px; border: 2px solid #20202a; border-radius: 6px; padding: 0 18px; background: #ffd84d; font-size: 11px; font-weight: 900; }
