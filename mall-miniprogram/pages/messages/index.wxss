.page { min-height: 100vh; padding: 0 16px 94px; background: #fffefa; color: #20202a; }
.header { display: flex; min-height: 70px; align-items: center; justify-content: space-between; border-bottom: 2px solid #20202a; }
.kicker { display: block; color: #ed5b49; font-size: 9px; font-weight: 900; letter-spacing: 1px; }
.title { display: block; margin-top: 4px; font-size: 28px; font-weight: 900; }
.read-all { width: 76px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 6px; padding: 0 !important; background: #ffd84d; font-size: 10px; font-weight: 900; }
.category-scroll { width: calc(100% + 32px); margin-left: -16px; padding: 14px 0 12px; white-space: nowrap; }
.categories { display: inline-flex; gap: 8px; padding: 0 16px; }
.category { display: inline-flex; width: auto !important; min-width: 78px; height: 48px; flex-direction: column; justify-content: center; margin: 0 !important; border: 2px solid #20202a; border-radius: 6px; padding: 0 10px !important; background: #fff; font-size: 10px; font-weight: 900; line-height: 1.35; }
.category text:last-child { color: #77737d; font-size: 8px; font-weight: 600; }
.category.active { background: #d6f2eb; box-shadow: 2px 2px 0 #20202a; }
.message-list { display: grid; gap: 10px; }
.message { border: 2px solid #aaa5a0; border-radius: 8px; padding: 13px; background: #fff; }
.message.unread { border-color: #20202a; box-shadow: 3px 3px 0 rgb(32 32 42 / 12%); }
.message-head,.message-foot,.message-title-wrap { display: flex; align-items: center; }
.message-head,.message-foot { justify-content: space-between; gap: 10px; }
.message-title-wrap { min-width: 0; gap: 6px; }
.dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #ed5b49; }
.message-title { overflow: hidden; font-size: 13px; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.message-time { flex: 0 0 auto; color: #77737d; font-size: 8px; }
.message-summary { display: -webkit-box; overflow: hidden; margin: 8px 0 10px; color: #5f5b62; font-size: 10px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.message-foot { border-top: 1px solid #d6d1ca; padding-top: 9px; color: #77737d; font-size: 8px; }
.message-foot text:last-child { color: #ed5b49; font-weight: 900; }
.feedback { display: block; margin-bottom: 10px; border: 2px solid #20202a; border-radius: 6px; padding: 8px; background: #d6f2eb; font-size: 10px; text-align: center; }
.empty { display: flex; min-height: 360px; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 11px; text-align: center; }
.empty-title { color: #20202a; font-size: 18px; font-weight: 900; }
.empty button { height: 40px; margin-top: 4px; border: 2px solid #20202a; border-radius: 6px; padding: 0 18px; background: #ffd84d; font-size: 11px; font-weight: 900; }
.mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; background: rgb(32 32 42 / 48%); }
.detail-sheet { width: 100%; max-height: 72vh; overflow-y: auto; border: 2px solid #20202a; border-bottom: 0; border-radius: 12px 12px 0 0; padding: 20px 16px calc(22px + env(safe-area-inset-bottom)); background: #fffefa; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.sheet-title { display: block; margin-top: 5px; font-size: 19px; font-weight: 900; }
.close { width: 32px !important; min-width: 32px !important; height: 32px; margin: 0 !important; border: 2px solid #20202a; border-radius: 50%; padding: 0 !important; background: #fff; font-size: 22px; line-height: 27px; }
.detail-content { display: block; margin: 18px 0; font-size: 12px; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.business-no { display: block; border-top: 1px solid #d6d1ca; padding-top: 10px; color: #77737d; font-size: 9px; overflow-wrap: anywhere; }
.action { width: 100%; height: 42px; margin-top: 16px; border: 2px solid #20202a; border-radius: 6px; background: #ed5b49; color: #fff; font-size: 12px; font-weight: 900; }
