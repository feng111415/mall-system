.page { min-height: 100vh; padding: 0 16px 32px; background: #fffefa; color: #20202a; }.topbar { display: grid; min-height: 52px; grid-template-columns: 42px 1fr 42px; align-items: center; border-bottom: 2px solid #20202a; font-size: 15px; font-weight: 900; text-align: center; }.back { width: 34px !important; min-width: 0 !important; height: 34px; margin: 0 !important; border: 2px solid #20202a; border-radius: 7px; padding: 0 !important; background: #fff; font-size: 20px; }.after-sale-list { display: grid; gap: 12px; padding-top: 14px; }.after-sale-card { border: 2px solid #20202a; border-radius: 8px; background: #fff; box-shadow: 3px 3px 0 rgb(32 32 42 / 12%); }.card-head,.card-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 12px; }.card-head { border-bottom: 1px solid #d6d1ca; }.card-type,.card-number { display: block; }.card-type { font-size: 14px; font-weight: 900; }.card-number { margin-top: 3px; color: #77737d; font-size: 9px; }.status { flex: 0 0 auto; border: 2px solid #20202a; border-radius: 99px; padding: 4px 7px; background: #ffd84d; font-size: 9px; font-weight: 900; }.card-body { display: grid; gap: 6px; padding: 12px; font-size: 11px; }.card-product { font-size: 12px; font-weight: 900; }.card-meta { color: #5f5b62; }.card-foot { border-top: 1px solid #d6d1ca; color: #ed5b49; font-size: 10px; font-weight: 800; }.card-message { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.empty { display: flex; min-height: 360px; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #77737d; font-size: 11px; text-align: center; }.empty-title { color: #20202a; font-size: 18px; font-weight: 900; }.empty-button { height: 40px; margin-top: 5px; border: 2px solid #20202a; border-radius: 6px; padding: 0 18px; background: #ffd84d; font-size: 11px; font-weight: 900; }
