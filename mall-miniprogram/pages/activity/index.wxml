<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><button class="back" bindtap="goBack">←</button><text>收藏与足迹</text><text></text></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" />
  <view wx:if="{{!loading && !loggedIn}}" class="empty"><text class="empty-title">登录后查看收藏与足迹</text><text>收藏和浏览记录只保存在当前会员账号中。</text><button bindtap="goLogin">去登录</button></view>
  <block wx:elif="{{!loading && !error}}">
    <view class="tabs"><button class="{{tab === 'favorites' ? 'active' : ''}}" data-value="favorites" bindtap="changeTab">我的收藏 · {{favorites.length}}</button><button class="{{tab === 'history' ? 'active' : ''}}" data-value="history" bindtap="changeTab">浏览足迹 · {{history.length}}</button></view>
    <view wx:if="{{tab === 'history' && history.length}}" class="toolbar"><button bindtap="toggleAll">{{allSelected ? '取消全选' : '全选'}}</button><text>已选 {{selectedCount}} 条</text><button class="delete-selected" disabled="{{!selectedCount || busy}}" bindtap="removeSelected">删除所选</button><button class="clear" disabled="{{busy}}" bindtap="openClear">清空</button></view>
    <text wx:if="{{feedback}}" class="feedback">{{feedback}}</text>
    <view wx:if="{{tab === 'favorites' && favorites.length}}" class="product-list"><view wx:for="{{favorites}}" wx:key="spuId" class="product-card {{item.available ? '' : 'invalid'}}"><view class="product-main" data-id="{{item.spuId}}" data-available="{{item.available}}" bindtap="openProduct"><view class="image-wrap"><image src="{{item.displayImage}}" mode="aspectFill" /><text wx:if="{{!item.available}}">已失效</text></view><view class="copy"><text class="meta">{{item.available ? '已收藏' : '商品已下架或删除'}}</text><text class="name">{{item.productName}}</text><text class="subtitle">{{item.available ? (item.subtitle || '查看商品详情') : '暂时不能查看和购买'}}</text><text class="price">¥{{item.displayPrice}}</text></view></view><button class="remove" data-id="{{item.spuId}}" disabled="{{busyId > 0}}" catchtap="removeFavorite">取消收藏</button></view></view>
    <view wx:elif="{{tab === 'history' && history.length}}" class="history-list"><view wx:for="{{historyGroups}}" wx:key="key" class="history-group"><text class="date-title">{{item.label}}</text><view class="product-list"><view wx:for="{{item.items}}" wx:for-item="product" wx:key="spuId" class="product-card history-card {{product.available ? '' : 'invalid'}} {{product.selected ? 'selected' : ''}}"><button class="select" data-id="{{product.spuId}}" catchtap="toggleHistory">{{product.selected ? '✓' : ''}}</button><view class="product-main" data-id="{{product.spuId}}" data-available="{{product.available}}" bindtap="openProduct"><view class="image-wrap"><image src="{{product.displayImage}}" mode="aspectFill" /><text wx:if="{{!product.available}}">已失效</text></view><view class="copy"><text class="meta">{{product.displayViewTime}} · 浏览 {{product.viewCount}} 次</text><text class="name">{{product.productName}}</text><text class="subtitle">{{product.available ? (product.subtitle || '继续查看商品') : '商品已下架或删除'}}</text><text class="price">¥{{product.displayPrice}}</text></view></view><button class="remove" data-id="{{product.spuId}}" disabled="{{busyId > 0}}" catchtap="removeHistory">删除记录</button></view></view></view></view>
    <view wx:else class="empty"><text class="empty-title">{{tab === 'favorites' ? '还没有收藏商品' : '还没有浏览足迹'}}</text><text>{{tab === 'favorites' ? '在商品详情点击收藏，喜欢的商品会保存在这里。' : '登录后浏览商品，最近看过的内容会保存在这里。'}}</text></view>
  </block>
  <view wx:if="{{clearOpen}}" class="mask" bindtap="closeClear"><view class="confirm" catchtap="noop"><text class="confirm-title">清空全部浏览足迹？</text><text class="confirm-note">清空后无法恢复，收藏不会受到影响。</text><text wx:if="{{clearError}}" class="confirm-error">{{clearError}}</text><view><button bindtap="closeClear">取消</button><button class="danger" loading="{{busy}}" disabled="{{busy}}" bindtap="clearHistory">确认清空</button></view></view></view>
</view>
