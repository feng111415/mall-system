<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><view class="brand"><text class="mark">拾</text><view><text class="brand-name">拾光小店</text><text class="brand-subtitle">把喜欢装进口袋里</text></view></view></view>
  <view class="search"><image class="search-icon" src="/assets/icons/search.svg" /><input placeholder="搜索好物、品类或灵感" confirm-type="search" bindconfirm="openCatalog" /><text class="search-action" bindtap="openCatalog">搜索</text></view>

  <state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" />
  <block wx:if="{{!loading && !error}}">
    <view class="welcome">
      <view><text class="welcome-title">{{greeting}}</text><text wx:if="{{loggedIn}}" class="welcome-subtitle">收藏 {{activitySummary.favoriteCount || 0}} 件 · 足迹 {{activitySummary.historyCount || 0}} 件</text><text wx:else class="welcome-subtitle" bindtap="openLogin">登录后查看订单和个人摘要 →</text></view>
      <image wx:if="{{avatarSrc}}" class="avatar" src="{{avatarSrc}}" mode="aspectFill" /><view wx:else class="avatar avatar-fallback">{{avatarLetter}}</view>
    </view>

    <scroll-view wx:if="{{tickers.length}}" class="ticker" scroll-x enhanced show-scrollbar="{{false}}"><view class="ticker-row"><view wx:for="{{tickers}}" wx:key="index" class="ticker-item"><text>{{item.label}}</text><text>{{item.text}}</text></view></view></scroll-view>

    <view class="order-strip"><view class="section-head"><text>我的订单</text><text class="link" bindtap="openOrders">{{loggedIn ? '全部订单 →' : '登录查看 →'}}</text></view><view class="orders"><view class="order" data-status="PENDING_PAYMENT" bindtap="openOrders"><text wx:if="{{orderSummary.pendingPayment}}" class="order-badge">{{orderSummary.pendingPayment}}</text><image class="order-icon" src="/assets/icons/wallet-cards.svg" /><text>待付款</text></view><view class="order" data-status="PENDING_SHIPMENT" bindtap="openOrders"><text wx:if="{{orderSummary.pendingShipment}}" class="order-badge">{{orderSummary.pendingShipment}}</text><image class="order-icon" src="/assets/icons/package-check.svg" /><text>待发货</text></view><view class="order" data-status="SHIPPED" bindtap="openOrders"><text wx:if="{{orderSummary.pendingReceipt}}" class="order-badge">{{orderSummary.pendingReceipt}}</text><image class="order-icon" src="/assets/icons/truck.svg" /><text>待收货</text></view><view class="order" data-status="COMPLETED" bindtap="openOrders"><text wx:if="{{orderSummary.pendingReview}}" class="order-badge">{{orderSummary.pendingReview}}</text><image class="order-icon" src="/assets/icons/messages-square.svg" /><text>待评价</text></view></view></view>

    <view class="service-grid"><view wx:for="{{services}}" wx:key="title" class="service {{item.color}}" data-title="{{item.title}}" bindtap="openService"><view class="service-icon"><image src="{{item.icon}}" /></view><view><text class="service-title">{{item.title}}</text><text class="service-subtitle">{{item.subtitle}}</text></view></view></view>

    <view class="offer" bindtap="openCatalog"><view class="offer-copy"><text class="offer-kicker">{{hero.heroEyebrow}}</text><text class="offer-title">{{hero.heroTitle}}</text><text class="offer-subtitle">{{hero.heroSubtitle}}</text><button>{{hero.heroActionText}}</button></view><image src="{{hero.displayImage}}" mode="aspectFill" /></view>

    <view class="section-head product-head"><view><text class="kicker">{{recommendationKicker}}</text><text class="product-title">{{recommendationTitle}}</text></view><text class="link" bindtap="openCatalog">再看更多 →</text></view>
    <view wx:if="{{products.length}}" class="product-list"><view wx:for="{{products}}" wx:key="spuId" class="product" data-id="{{item.spuId}}" bindtap="openProduct"><image src="{{item.displayImage}}" mode="aspectFill" /><view><text wx:if="{{item.badge}}" class="product-badge">{{item.badge}}</text><text class="product-name">{{item.productName}}</text><text class="product-subtitle">{{item.subtitle}}</text><text class="price">¥{{item.displayPrice}}</text></view><button aria-label="查看商品"><text>→</text></button></view></view>
    <view wx:else class="empty-products"><text>精选商品正在整理</text><button bindtap="openCatalog">查看全部商品</button></view>
  </block>
</view>
