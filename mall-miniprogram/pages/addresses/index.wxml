<view class="page">
  <view style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar"><button class="back" bindtap="goBack">←</button><text>收货地址</text><button wx:if="{{loggedIn}}" class="add" bindtap="openCreate">＋</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="handleRetry" />
  <view wx:if="{{!loading && !loggedIn}}" class="empty"><text class="empty-title">登录后管理地址</text><text>地址只保存在当前会员账号中。</text><button bindtap="goLogin">去登录</button></view>
  <block wx:elif="{{!loading && !error}}">
    <text wx:if="{{feedback}}" class="feedback">{{feedback}}</text>
    <view wx:if="{{addresses.length}}" class="address-list"><view wx:for="{{addresses}}" wx:key="addressId" class="address-card {{item.defaultFlag ? 'default-card' : ''}}"><view class="address-copy"><view class="receiver"><text>{{item.receiverName}}</text><text>{{item.receiverPhone}}</text><text wx:if="{{item.defaultFlag}}" class="default-tag">默认</text></view><text class="address-text">{{item.displayAddress}}</text><text wx:if="{{item.postalCode}}" class="postal">邮编 {{item.postalCode}}</text></view><view class="tools {{item.defaultFlag ? 'two-tools' : ''}}"><button wx:if="{{!item.defaultFlag}}" data-id="{{item.addressId}}" disabled="{{busyId > 0}}" bindtap="setDefault">设为默认</button><button data-id="{{item.addressId}}" disabled="{{busyId > 0}}" bindtap="openEdit">编辑</button><button class="danger" data-id="{{item.addressId}}" disabled="{{busyId > 0}}" bindtap="openDelete">删除</button></view></view></view>
    <view wx:else class="empty"><text class="empty-title">还没有收货地址</text><text>新增后可在结算时直接选择。</text><button bindtap="openCreate">新增地址</button></view>
  </block>
  <view wx:if="{{formOpen}}" class="mask" bindtap="closeForm"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>{{formTitle}}</text><button bindtap="closeForm">×</button></view><view class="field-grid"><view class="field"><text>收货人</text><input data-field="receiverName" value="{{form.receiverName}}" maxlength="50" bindinput="handleInput" placeholder="姓名" /></view><view class="field"><text>手机号</text><input data-field="receiverPhone" value="{{form.receiverPhone}}" type="number" maxlength="11" bindinput="handleInput" placeholder="11 位手机号" /></view></view><view class="field"><text>省市区</text><picker mode="region" value="{{form.region}}" bindchange="handleRegion"><view class="region">{{form.regionText || '请选择省市区'}}<text>⌄</text></view></picker></view><view class="field"><text>详细地址</text><textarea data-field="detailAddress" value="{{form.detailAddress}}" maxlength="255" auto-height bindinput="handleInput" placeholder="街道、楼栋、门牌号" /></view><view class="field"><text>邮政编码 <text class="optional">选填</text></text><input data-field="postalCode" value="{{form.postalCode}}" maxlength="12" bindinput="handleInput" placeholder="邮政编码" /></view><view class="default-switch"><text>设为默认地址</text><switch checked="{{form.isDefault}}" color="#ed5b49" bindchange="handleDefault" /></view><text wx:if="{{formError}}" class="form-error">{{formError}}</text><button class="save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '正在保存...' : '保存地址'}}</button></view></view>
  <view wx:if="{{deleteAddress}}" class="mask" bindtap="closeDelete"><view class="confirm" catchtap="noop"><text class="confirm-title">删除收货地址？</text><text class="confirm-address">{{deleteAddress.receiverName}} · {{deleteAddress.displayAddress}}</text><view><button bindtap="closeDelete">取消</button><button class="confirm-danger" loading="{{busyId > 0}}" disabled="{{busyId > 0}}" bindtap="confirmDelete">确认删除</button></view></view></view>
</view>
