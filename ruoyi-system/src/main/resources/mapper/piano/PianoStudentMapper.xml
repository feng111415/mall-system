<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.piano.mapper.PianoStudentMapper">

    <resultMap type="PianoStudent" id="PianoStudentResult">
        <id     property="studentId"    column="student_id"    />
        <result property="studentName"  column="student_name"  />
        <result property="parentName"   column="parent_name"   />
        <result property="parentPhone"  column="parent_phone"  />
        <result property="levelName"    column="level_name"    />
        <result property="learningGoal" column="learning_goal" />
        <result property="status"       column="status"        />
        <result property="delFlag"      column="del_flag"      />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectPianoStudentVo">
        select student_id, student_name, parent_name, parent_phone, level_name, learning_goal,
               status, del_flag, create_by, create_time, update_by, update_time, remark
        from piano_student
    </sql>

    <select id="selectPianoStudentList" parameterType="PianoStudent" resultMap="PianoStudentResult">
        <include refid="selectPianoStudentVo"/>
        <where>
            del_flag = '0'
            <if test="studentName != null and studentName != ''">
                and student_name like concat('%', #{studentName}, '%')
            </if>
            <if test="parentName != null and parentName != ''">
                and parent_name like concat('%', #{parentName}, '%')
            </if>
            <if test="parentPhone != null and parentPhone != ''">
                and parent_phone like concat('%', #{parentPhone}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by student_id desc
    </select>

    <select id="selectPianoStudentOptions" resultMap="PianoStudentResult">
        select student_id, student_name, parent_name, level_name, status
        from piano_student
        where del_flag = '0' and status = '0'
        order by student_id desc
    </select>

    <select id="selectPianoStudentById" parameterType="Long" resultMap="PianoStudentResult">
        <include refid="selectPianoStudentVo"/>
        where student_id = #{studentId} and del_flag = '0'
    </select>

    <select id="selectActivePianoStudentCount" resultType="Long">
        select count(1)
        from piano_student
        where del_flag = '0' and status = '0'
    </select>

    <insert id="insertPianoStudent" parameterType="PianoStudent" useGeneratedKeys="true" keyProperty="studentId">
        insert into piano_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="parentName != null">parent_name,</if>
            <if test="parentPhone != null">parent_phone,</if>
            <if test="levelName != null">level_name,</if>
            <if test="learningGoal != null">learning_goal,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="parentName != null">#{parentName},</if>
            <if test="parentPhone != null">#{parentPhone},</if>
            <if test="levelName != null">#{levelName},</if>
            <if test="learningGoal != null">#{learningGoal},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updatePianoStudent" parameterType="PianoStudent">
        update piano_student
        <set>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="parentName != null">parent_name = #{parentName},</if>
            <if test="parentPhone != null">parent_phone = #{parentPhone},</if>
            <if test="levelName != null">level_name = #{levelName},</if>
            <if test="learningGoal != null">learning_goal = #{learningGoal},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where student_id = #{studentId} and del_flag = '0'
    </update>

    <update id="deletePianoStudentById" parameterType="Long">
        update piano_student set del_flag = '2', update_time = sysdate()
        where student_id = #{studentId}
    </update>

    <update id="deletePianoStudentByIds" parameterType="Long">
        update piano_student set del_flag = '2', update_time = sysdate()
        where student_id in
        <foreach collection="array" item="studentId" open="(" separator="," close=")">
            #{studentId}
        </foreach>
    </update>
</mapper>
