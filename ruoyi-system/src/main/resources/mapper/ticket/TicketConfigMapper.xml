<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ticket.mapper.TicketConfigMapper">

    <resultMap type="TicketConfig" id="TicketConfigResult">
        <id     property="configId" column="config_id" />
        <result property="configKey" column="config_key" />
        <result property="configValue" column="config_value" />
        <result property="configName" column="config_name" />
        <result property="configType" column="config_type" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectTicketConfigVo">
        select config_id, config_key, config_value, config_name, config_type, status, create_by, create_time, update_by, update_time, remark
        from ticket_config
    </sql>

    <select id="selectTicketConfigList" parameterType="TicketConfig" resultMap="TicketConfigResult">
        <include refid="selectTicketConfigVo"/>
        <where>
            <if test="configKey != null and configKey != ''">
                and config_key like concat('%', #{configKey}, '%')
            </if>
            <if test="configName != null and configName != ''">
                and config_name like concat('%', #{configName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status like concat('%', #{status}, '%')
            </if>
        </where>
        order by config_id desc
    </select>

    <select id="selectTicketConfigById" parameterType="Long" resultMap="TicketConfigResult">
        <include refid="selectTicketConfigVo"/>
        where config_id = #{configId}
    </select>

    <insert id="insertTicketConfig" parameterType="TicketConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into ticket_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configKey != null">config_key,</if>
            <if test="configValue != null">config_value,</if>
            <if test="configName != null">config_name,</if>
            <if test="configType != null">config_type,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configKey != null">#{configKey},</if>
            <if test="configValue != null">#{configValue},</if>
            <if test="configName != null">#{configName},</if>
            <if test="configType != null">#{configType},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateTicketConfig" parameterType="TicketConfig">
        update ticket_config
        <set>
            <if test="configKey != null">config_key = #{configKey},</if>
            <if test="configValue != null">config_value = #{configValue},</if>
            <if test="configName != null">config_name = #{configName},</if>
            <if test="configType != null">config_type = #{configType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where config_id = #{configId}
    </update>

    <delete id="deleteTicketConfigById" parameterType="Long">
        delete from ticket_config where config_id = #{configId}
    </delete>

    <delete id="deleteTicketConfigByIds" parameterType="Long">
        delete from ticket_config where config_id in
        <foreach collection="array" item="configId" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>
</mapper>
