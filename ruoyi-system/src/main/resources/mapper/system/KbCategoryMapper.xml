<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.KbCategoryMapper">

    <resultMap type="KbCategory" id="KbCategoryResult">
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="orderNum" column="order_num"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    
    <sql id="selectKbCategoryVo">
    SELECT category_id, category_name, order_num, status,
           create_time, update_time, remark
    FROM kb_category
</sql>

<select id="selectKbCategoryById"
        parameterType="Long"
        resultMap="KbCategoryResult">
    <include refid="selectKbCategoryVo"/>
    WHERE category_id = #{categoryId}
</select>

<select id="selectKbCategoryList"
        parameterType="KbCategory"
        resultMap="KbCategoryResult">
    <include refid="selectKbCategoryVo"/>
    <where>
        <if test="categoryName != null and categoryName != ''">
            AND category_name LIKE concat('%', #{categoryName}, '%')
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
    </where>
    ORDER BY order_num ASC, category_id DESC
</select>

<insert id="insertKbCategory"
        parameterType="KbCategory"
        useGeneratedKeys="true"
        keyProperty="categoryId">
    INSERT INTO kb_category (
        category_name,
        order_num,
        status,
        create_time,
        remark
    )
    VALUES (
        #{categoryName},
        #{orderNum},
        #{status},
        #{createTime},
        #{remark}
    )
</insert>

<update id="updateKbCategory" parameterType="KbCategory">
    UPDATE kb_category
    <set>
        <if test="categoryName != null and categoryName != ''">
            category_name = #{categoryName},
        </if>
        <if test="orderNum != null">
            order_num = #{orderNum},
        </if>
        <if test="status != null and status != ''">
            status = #{status},
        </if>
        update_time = #{updateTime},
        <if test="remark != null">
            remark = #{remark},
        </if>
    </set>
    WHERE category_id = #{categoryId}
</update>

<delete id="deleteKbCategoryById" parameterType="Long">
    DELETE FROM kb_category
    WHERE category_id = #{categoryId}
</delete>

<delete id="deleteKbCategoryByIds">
    DELETE FROM kb_category
    WHERE category_id IN
    <foreach
        item="categoryId"
        collection="array"
        open="("
        separator=","
        close=")">
        #{categoryId}
    </foreach>
</delete>
</mapper>